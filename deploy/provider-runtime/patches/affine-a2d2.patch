--- /dev/null
+++ b/packages/backend/server/src/core/auth/a2d2/__tests__/broker.spec.ts
@@ -0,0 +1,155 @@
+import { createHash, createHmac } from 'node:crypto';
+import {
+  createServer,
+  type IncomingMessage,
+  type ServerResponse,
+} from 'node:http';
+
+import ava, { type ExecutionContext } from 'ava';
+
+import type { Config } from '../../../../base/config/config';
+import { A2d2BrokerClient } from '../broker';
+import { A2d2AuthError } from '../error';
+
+const SECRET = 'a'.repeat(32);
+const COMMUNITY_ID = '11111111-1111-4111-8111-111111111111';
+const PUBKEY = 'b'.repeat(64);
+
+async function withBroker(
+  t: ExecutionContext,
+  handler: (req: IncomingMessage, res: ServerResponse, body: string) => void
+) {
+  const server = createServer((req, res) => {
+    const chunks: Buffer[] = [];
+    req.on('data', chunk => chunks.push(Buffer.from(chunk)));
+    req.on('end', () => handler(req, res, Buffer.concat(chunks).toString()));
+  });
+  await new Promise<void>((resolve, reject) => {
+    server.once('error', reject);
+    server.listen(0, '127.0.0.1', resolve);
+  });
+  t.teardown(() => new Promise<void>(resolve => server.close(() => resolve())));
+  const address = server.address();
+  if (!address || typeof address === 'string') throw new Error('no address');
+  const config = {
+    a2d2Auth: {
+      enabled: true,
+      brokerUrl: `http://127.0.0.1:${address.port}`,
+      origin: 'https://affine.example',
+      engineSecret: SECRET,
+    },
+  } as Config;
+  const client = new A2d2BrokerClient(config);
+  client.onModuleInit();
+  return client;
+}
+
+function success(res: ServerResponse) {
+  res.writeHead(200, { 'content-type': 'application/json' });
+  res.end(
+    JSON.stringify({
+      session_token: 's'.repeat(32),
+      community_id: COMMUNITY_ID,
+      pubkey: PUBKEY,
+      role: 'owner',
+      principal_key: `affine:${COMMUNITY_ID}:${PUBKEY}`,
+      expires_at: Math.floor(Date.now() / 1000) + 60,
+    })
+  );
+}
+
+ava('broker signs the exact exchange body and binds AFFiNE scope', async t => {
+  const client = await withBroker(t, (req, res, body) => {
+    t.is(req.url, '/api/engine/v1/exchange');
+    const timestamp = req.headers['x-a2d2-engine-timestamp'];
+    const signature = req.headers['x-a2d2-engine-signature'];
+    t.is(typeof timestamp, 'string');
+    t.is(typeof signature, 'string');
+    const bodyHash = createHash('sha256').update(body).digest('hex');
+    t.is(
+      signature,
+      createHmac('sha256', SECRET)
+        .update(`${timestamp}\n${bodyHash}`)
+        .digest('hex')
+    );
+    t.deepEqual(JSON.parse(body), {
+      code: 'one-time-code',
+      product: 'affine',
+      origin: 'https://affine.example',
+      mount_session: '22222222-2222-4222-8222-222222222222',
+      callback_state: 'state',
+    });
+    success(res);
+  });
+
+  const principal = await client.exchange({
+    code: 'one-time-code',
+    mountSession: '22222222-2222-4222-8222-222222222222',
+    callbackState: 'state',
+  });
+  t.is(principal.community_id, COMMUNITY_ID);
+  t.is(principal.pubkey, PUBKEY);
+});
+
+ava(
+  'broker rejects redirects without forwarding the signed request',
+  async t => {
+    let requests = 0;
+    const client = await withBroker(t, (_req, res) => {
+      requests += 1;
+      res.writeHead(302, { location: 'http://127.0.0.1:1/capture' });
+      res.end();
+    });
+
+    const error = await t.throwsAsync(
+      client.exchange({
+        code: 'code',
+        mountSession: '22222222-2222-4222-8222-222222222222',
+        callbackState: 'state',
+      })
+    );
+    t.true(error instanceof A2d2AuthError);
+    t.is((error as A2d2AuthError).code, 'broker_unavailable');
+    t.is(requests, 1);
+  }
+);
+
+ava('broker preserves the stable membership denial code', async t => {
+  const client = await withBroker(t, (_req, res) => {
+    res.writeHead(403, { 'content-type': 'application/json' });
+    res.end(JSON.stringify({ error: 'scope_or_membership_denied' }));
+  });
+
+  const error = await t.throwsAsync(client.check('s'.repeat(32)));
+  t.true(error instanceof A2d2AuthError);
+  t.is((error as A2d2AuthError).code, 'scope_or_membership_denied');
+});
+
+ava('broker sends the complete scoped revoke body', async t => {
+  const client = await withBroker(t, (req, res, body) => {
+    t.is(req.url, '/api/engine/v1/session/revoke');
+    t.deepEqual(JSON.parse(body), {
+      session_token: 's'.repeat(32),
+      product: 'affine',
+      origin: 'https://affine.example',
+    });
+    res.writeHead(204);
+    res.end();
+  });
+
+  await t.notThrowsAsync(client.revoke('s'.repeat(32)));
+});
+
+ava(
+  'broker distinguishes an expired session from membership removal',
