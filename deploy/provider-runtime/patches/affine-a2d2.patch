+name: a2d2-affine-full
+x-affine: &affine
+  image: ${AFFINE_IMAGE:?Set a verified AFFiNE image digest}
+  volumes:
+    - storage:/root/.affine/storage
+    - config:/root/.affine/config
+  environment: &environment
+    REDIS_SERVER_HOST: redis
+    DATABASE_URL: postgresql://affine:${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD}@postgres:5432/affine
+    DEPLOYMENT_TYPE: selfhosted
+    AFFINE_SERVER_EXTERNAL_URL: ${AFFINE_EXTERNAL_URL:-http://127.0.0.1:3010}
+    AFFINE_SERVER_HOST: ${AFFINE_SERVER_HOST:-127.0.0.1}
+    AFFINE_SERVER_PORT: '3010'
+    AFFINE_SERVER_HTTPS: ${AFFINE_SERVER_HTTPS:-false}
+    AFFINE_A2D2_AUTH_ENABLED: ${AFFINE_A2D2_AUTH_ENABLED:-false}
+    AFFINE_A2D2_BROKER_URL: ${AFFINE_A2D2_BROKER_URL:-}
+    AFFINE_A2D2_ORIGIN: ${AFFINE_A2D2_ORIGIN:-}
+    AFFINE_A2D2_ENGINE_SECRET: ${AFFINE_A2D2_ENGINE_SECRET:-}
+services:
+  affine:
+    <<: *affine
+    ports:
+      - '127.0.0.1:3010:3010'
+    depends_on:
+      migration:
+        condition: service_completed_successfully
+    healthcheck:
+      test: ['CMD', 'node', '-e', 'fetch("http://127.0.0.1:3010/info").then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))']
+      interval: 15s
+      timeout: 5s
+      retries: 12
+      start_period: 30s
+    restart: unless-stopped
+  migration:
+    <<: *affine
+    command: ['sh', '-c', 'node ./scripts/self-host-predeploy.js']
+    depends_on:
+      postgres:
+        condition: service_healthy
+      redis:
+        condition: service_healthy
+    restart: 'no'
+  postgres:
+    image: ${POSTGRES_IMAGE:-pgvector/pgvector:pg16}
+    environment:
+      POSTGRES_USER: affine
+      POSTGRES_DB: affine
+      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD}
+      POSTGRES_INITDB_ARGS: --data-checksums
+    volumes:
