+declare global {
+  interface AppConfigSchema {
+    a2d2Auth: A2d2AuthConfig;
+  }
+}
+
+defineModuleConfig('a2d2Auth', {
+  enabled: {
+    desc: 'Enable A2D2-managed AFFiNE authentication.',
+    default: false,
+    env: ['AFFINE_A2D2_AUTH_ENABLED', 'boolean'],
+    shape: z.boolean(),
+  },
+  brokerUrl: {
