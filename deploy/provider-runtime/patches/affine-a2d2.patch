new file mode 100644
index 0000000..d5281e2
--- /dev/null
+++ b/deploy/a2d2/verify_runtime.py
@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+"""Probe complete AFFiNE runtime, optionally login and compare a saved server document.
+Credentials are read from environment and cookies remain only in memory.
+This does not create business data or claim native UI/third-party OAuth coverage.
+"""
+import argparse
+import hashlib
+import http.cookiejar
+import json
+import os
+from pathlib import Path
+import urllib.error
+import urllib.parse
+import urllib.request
+
+class NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, *args, **kwargs):
+        raise RuntimeError('unexpected-http-redirect')
+
+def client():
+    return urllib.request.build_opener(NoRedirect(), urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
+
+def request(opener, url, data=None):
+    body = None if data is None else json.dumps(data).encode()
+    req = urllib.request.Request(url, data=body, headers={'Content-Type':'application/json'} if body else {})
+    with opener.open(req, timeout=30) as response:
+        content = response.read(32 * 1024 * 1024 + 1)
+        if len(content) > 32 * 1024 * 1024: raise RuntimeError('response-too-large')
+        return response.status, response.headers.get('Content-Type',''), content
+
+def login(opener, base, email, password):
+    parsed = urllib.parse.urlparse(base)
+    if parsed.scheme != 'https' and parsed.hostname not in ('localhost','127.0.0.1','::1'):
+        raise RuntimeError('credentials-require-https-or-loopback')
+    status, _, _ = request(opener, base + '/api/auth/sign-in', {'email':email,'password':password})
+    if status != 200: raise RuntimeError('login-failed')
+
+def denied(opener, url):
+    try:
+        request(opener, url)
+    except urllib.error.HTTPError as error:
+        if error.code in (401,403,404):
+            code = error.code; error.close(); return code
+        raise
+    raise RuntimeError('private-document-readable-by-outsider')
+
+def probe(base, workspace=None, doc=None, expected=None, email=None, password=None,
+          other_email=None, other_password=None, save_binary=None):
+    base = base.rstrip('/')
+    parsed = urllib.parse.urlparse(base)
+    if parsed.scheme not in ('http','https') or parsed.username or parsed.password:
+        raise RuntimeError('invalid-base-url')
+    opener = client()
+    _, _, raw = request(opener, base + '/info')
+    info = json.loads(raw)
+    if info.get('compatibility') != '0.27.4': raise RuntimeError('version-mismatch')
+    status, content_type, html = request(opener, base + '/')
+    if status != 200 or 'text/html' not in content_type or b'<html' not in html.lower():
+        raise RuntimeError('ui-not-html')
+    result = {'baseUrl':base,'version':info['compatibility'],'uiStatus':status,'login':'not-tested','document':'not-tested','otherAccount':'not-tested'}
+    if bool(email) != bool(password): raise RuntimeError('both-login-values-required')
+    if email:
+        login(opener, base, email, password)
+        result['login'] = 'passed'
+    if workspace or doc:
+        if not (workspace and doc and email): raise RuntimeError('document-check-requires-login-workspace-doc')
+        url = base + '/api/workspaces/' + urllib.parse.quote(workspace,safe='') + '/docs/' + urllib.parse.quote(doc,safe='')
+        _, content_type, binary = request(opener, url)
+        if 'application/octet-stream' not in content_type or not binary: raise RuntimeError('document-not-binary')
+        digest = hashlib.sha256(binary).hexdigest()
+        if expected and digest != expected: raise RuntimeError('document-hash-mismatch')
+        if save_binary: Path(save_binary).write_bytes(binary)
+        result.update(document='passed',documentSha256=digest,documentBytes=len(binary),anonymousDenied=denied(client(),url))
+        if other_email or other_password:
+            if not (other_email and other_password): raise RuntimeError('both-other-account-values-required')
+            other = client(); login(other,base,other_email,other_password)
+            result['otherAccount'] = {'deniedStatus':denied(other,url)}
+    return result
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--base-url',required=True)
+    parser.add_argument('--workspace'); parser.add_argument('--doc')
+    parser.add_argument('--expected-sha256'); parser.add_argument('--save-binary')
+    parser.add_argument('--out',required=True)
+    args = parser.parse_args()
+    result = probe(args.base_url,args.workspace,args.doc,args.expected_sha256,
+                   os.getenv('AFFINE_QA_EMAIL'),os.getenv('AFFINE_QA_PASSWORD'),
+                   os.getenv('AFFINE_OTHER_EMAIL'),os.getenv('AFFINE_OTHER_PASSWORD'),args.save_binary)
+    Path(args.out).write_text(json.dumps(result,indent=2))
+    print(json.dumps(result))
