@@ -0,0 +1,38 @@
+import { HttpStatus } from '@nestjs/common';
+
+import { UserFriendlyError } from '../../../base';
+
+export type A2d2AuthErrorCode =
+  | 'invalid_request'
+  | 'server_auth_invalid'
+  | 'session_invalid_or_expired'
+  | 'session_scope_mismatch'
+  | 'scope_or_membership_denied'
+  | 'launch_invalid_or_expired'
+  | 'broker_unavailable'
+  | 'community_not_provisioned'
+  | 'community_owner_conflict';
+
+const STATUS: Record<A2d2AuthErrorCode, HttpStatus> = {
+  invalid_request: HttpStatus.BAD_REQUEST,
+  server_auth_invalid: HttpStatus.UNAUTHORIZED,
+  session_invalid_or_expired: HttpStatus.UNAUTHORIZED,
+  session_scope_mismatch: HttpStatus.FORBIDDEN,
+  scope_or_membership_denied: HttpStatus.FORBIDDEN,
+  launch_invalid_or_expired: HttpStatus.GONE,
+  broker_unavailable: HttpStatus.SERVICE_UNAVAILABLE,
+  community_not_provisioned: HttpStatus.CONFLICT,
+  community_owner_conflict: HttpStatus.CONFLICT,
+};
+
+export class A2d2AuthError extends UserFriendlyError {
+  constructor(readonly code: A2d2AuthErrorCode) {
+    super('action_forbidden', 'http_request_error', code);
+    this.name = code;
+    this.status = STATUS[code];
+  }
+
+  override toJSON() {
+    return { ...super.toJSON(), error: this.code };
+  }
+}
