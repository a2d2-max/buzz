index 0000000..693399f
--- /dev/null
+++ b/packages/backend/server/src/core/doc/a2d2/token.ts
@@ -0,0 +1,52 @@
+import { createHash, timingSafeEqual } from 'node:crypto';
+
+/**
+ * 서비스 자격증명 허용목록.
+ *
+ * 계약은 Plane 쪽(`plane/a2d2/config.py`)과 **같은 모양**으로 맞춘다. 두 벌이
+ * 어긋나면 나중에 한쪽만 고치는 사고가 난다.
+ *
+ * - 옛 변수(해시 하나)는 그대로 동작한다
+ * - 새 변수(쉼표로 여럿)를 더해 합쳐 쓴다
+ * - 항목마다 64자리 소문자 hex 검사. **하나라도 깨지면 목록 전체를 버린다**
+ * - 비교는 timingSafeEqual — 걸린 시간으로 새지 않게
+ * - **목록이 비면 전부 거부한다.** 열려 버리는 쪽으로 무너지면 안 된다
+ */
+const HASH_SHAPE = /^[0-9a-f]{64}$/;
+
+export function parseTokenAllowlist(single: string, list: string): string[] {
+  const raw = [single, ...list.split(',')]
+    .map(entry => entry.trim())
+    .filter(entry => entry.length > 0);
+  if (raw.length === 0) return [];
+  if (!raw.every(entry => HASH_SHAPE.test(entry))) return [];
+  return [...new Set(raw)];
+}
+
+export function tokenMatchesAllowlist(
+  token: string,
+  allowlist: readonly string[]
+): boolean {
+  if (allowlist.length === 0) return false;
+  const presented = Buffer.from(
+    createHash('sha256').update(token, 'utf8').digest('hex'),
+    'utf8'
+  );
+  let matched = false;
+  for (const candidate of allowlist) {
+    const expected = Buffer.from(candidate, 'utf8');
+    if (
+      expected.length === presented.length &&
+      timingSafeEqual(expected, presented)
+    ) {
+      matched = true;
+    }
+  }
+  return matched;
+}
+
+export function bearerToken(header: string | undefined): string | null {
+  if (!header) return null;
+  const match = /^Bearer\s+(\S+)$/.exec(header.trim());
+  return match ? match[1] : null;
+}
