diff --git a/deploy/a2d2/build-managed-image.sh b/deploy/a2d2/build-managed-image.sh
new file mode 100755
index 0000000..65af4c9
--- /dev/null
+++ b/deploy/a2d2/build-managed-image.sh
@@ -0,0 +1,96 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+repo=$(cd "$(dirname "$0")/../.." && pwd)
+out=${1:?Usage: build-managed-image.sh OUT_DIR [IMAGE_TAG]}
+tag=${2:-a2d2-affine-managed:0.27.4-a2d2}
+expected_revision=b4c8548c09da21b2898443559a5b846f0ccf5dd8
+image_version=0.27.4-a2d2
+builder=${A2D2_DOCKER_BUILDER:-desktop-linux}
+stage=$(mktemp -d)
+mkdir -p "$out"
+trap 'rm -rf "$stage"' EXIT
+
+cd "$repo"
+test "$(git rev-parse HEAD)" = "$expected_revision"
+
+# The pinned upstream images are used only as immutable sources for the
+# unchanged native addon that the official build workflow downloads separately.
+extract_native() {
+  digest=$1
+  name=$2
+  expected=$3
+  target="packages/backend/native/$name"
+  if [ ! -f "$target" ] || [ "$(shasum -a 256 "$target" | awk '{print $1}')" != "$expected" ]; then
+    container=$(docker create "ghcr.io/toeverything/affine@$digest")
+    trap 'docker rm -f "$container" >/dev/null 2>&1 || true; rm -rf "$stage"' EXIT
+    docker cp "$container:/app/dist/$name" "$target"
+    docker rm "$container" >/dev/null
+    trap 'rm -rf "$stage"' EXIT
+  fi
+  test "$(shasum -a 256 "$target" | awk '{print $1}')" = "$expected"
+}
+
+mkdir -p packages/backend/native
+extract_native sha256:c312116a134184947d98749c8a8e29f4e3bc97f4f2a51c9a3497f9baea2eec2b \
+  server-native.x64.node 325288c6872b68f66cf5bb25fc16516af7e1adaaf12a4e973a02b25caf45270b
+extract_native sha256:adb3cea3eb4a50a6116dbab7dc045252b54ede3e73828a85a58daf78da3b1f6d \
+  server-native.arm64.node f47aa138462d8b296bef53cb0020b0f3bcde87f45fbf3830ffda2022afc93529
+extract_native sha256:558feb6d651ac5433a3c05d0c5459f3e5cbc659c1bc531598c6768163da630ff \
+  server-native.armv7.node 8c1ff199683211e1b5290b3769a235cd31f9b90f0bd3ef9cd342acaf3c145305
+
+yarn affine @affine/web build 2>&1 | tee "$out/web-build.log"
+yarn affine @affine/admin build 2>&1 | tee "$out/admin-build.log"
+yarn affine @affine/mobile build 2>&1 | tee "$out/mobile-build.log"
+yarn affine @affine/server build 2>&1 | tee "$out/server-build.log"
+grep -q 'compiled successfully' "$out/server-build.log"
+if grep -Eq 'Rspack compilation failed|Module not found|ERROR in ' "$out/server-build.log"; then
+  echo 'Server bundle contains a compilation error' >&2
+  exit 1
+fi
+
+# Mirror the official build-images workflow without replacing this checkout's
+# developer node_modules: make the production focus in a disposable context.
+rsync -a \
+  --exclude='.git' --exclude='node_modules' --exclude='target' \
+  --exclude='dist' --exclude='.cache' \
+  "$repo/" "$stage/"
+mkdir -p \
+  "$stage/packages/backend/server" \
+  "$stage/packages/frontend/apps/web" \
+  "$stage/packages/frontend/apps/mobile" \
+  "$stage/packages/frontend/admin"
+rsync -a "$repo/packages/backend/server/dist/" "$stage/packages/backend/server/dist/"
+rsync -a "$repo/packages/frontend/apps/web/dist/" "$stage/packages/frontend/apps/web/dist/"
+rsync -a "$repo/packages/frontend/apps/mobile/dist/" "$stage/packages/frontend/apps/mobile/dist/"
+rsync -a "$repo/packages/frontend/admin/dist/" "$stage/packages/frontend/admin/dist/"
+
+cd "$stage"
+yarn config set --json supportedArchitectures.os '["current","linux"]'
+yarn config set --json supportedArchitectures.cpu '["current","x64","arm64","arm"]'
+yarn config set --json supportedArchitectures.libc '["current","glibc"]'
+yarn workspaces focus @affine/server --production
+yarn workspace @affine/server prisma generate
+mv node_modules packages/backend/server/node_modules
+test -x packages/backend/server/node_modules/.bin/prisma
+test -d packages/backend/server/node_modules/@node-rs/argon2-linux-x64-gnu
+
+docker buildx build --builder "$builder" --platform linux/amd64 --pull --load \
+  -f deploy/a2d2/Dockerfile.managed \
+  --build-arg "SOURCE_REVISION=$expected_revision" \
+  --build-arg "IMAGE_VERSION=$image_version" \
+  -t "$tag" . 2>&1 | tee "$out/image-build.log"
+
+image_id=$(docker image inspect "$tag" --format '{{.Id}}')
+test "$(docker image inspect "$tag" --format '{{.Architecture}}/{{.Os}}')" = 'amd64/linux'
+docker save "$tag" | gzip -1 > "$out/affine-managed-linux-amd64.tar.gz"
+archive_sha=$(shasum -a 256 "$out/affine-managed-linux-amd64.tar.gz" | awk '{print $1}')
+cat > "$out/image-build-result.txt" <<EOF
+source_revision=$expected_revision
+image_tag=$tag
+image_id=$image_id
+platform=linux/amd64
+base_image=node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
+archive=affine-managed-linux-amd64.tar.gz
+archive_sha256=$archive_sha
+EOF
