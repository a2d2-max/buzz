diff --git a/packages/backend/server/src/core/auth/a2d2/controller.ts b/packages/backend/server/src/core/auth/a2d2/controller.ts
new file mode 100644
index 0000000..c33dcef
--- /dev/null
+++ b/packages/backend/server/src/core/auth/a2d2/controller.ts
@@ -0,0 +1,69 @@
+import {
+  Body,
+  Controller,
+  Header,
+  HttpCode,
+  HttpStatus,
+  Post,
+  Req,
+  Res,
+} from '@nestjs/common';
+import type { Request, Response } from 'express';
+import { z } from 'zod';
+
+import { Throttle } from '../../../base';
+import { Public } from '../guard';
+import { A2d2AuthError } from './error';
+import { A2d2ManagedAuthService } from './service';
+
+const ExchangeBodySchema = z
+  .object({
+    code: z.string().min(1).max(512),
+    mount_session: z.string().uuid(),
+    state: z.string().regex(/^[A-Za-z0-9_-]{43}$/),
+  })
+  .strict();
+
+@Throttle('strict')
+@Controller('/api/a2d2/session')
+export class A2d2SessionController {
+  constructor(private readonly auth: A2d2ManagedAuthService) {}
+
+  @Public()
+  @Post('/begin')
+  @Header('Cache-Control', 'no-store')
+  begin(@Req() req: Request, @Res({ passthrough: true }) res: Response) {
+    this.auth.assertOrigin(req);
+    return this.auth.begin(res);
+  }
+
+  @Public()
+  @Post('/exchange')
+  @Header('Cache-Control', 'no-store')
+  async exchange(
+    @Req() req: Request,
+    @Res({ passthrough: true }) res: Response,
+    @Body() body?: unknown
+  ) {
+    this.auth.assertOrigin(req);
+    const input = ExchangeBodySchema.safeParse(body);
+    if (!input.success) {
+      this.auth.clearStateCookie(res);
+      throw new A2d2AuthError('invalid_request');
+    }
+    return await this.auth.exchange(req, res, {
+      code: input.data.code,
+      mountSession: input.data.mount_session,
+      state: input.data.state,
+    });
+  }
+
+  @Public()
+  @Post('/revoke')
+  @HttpCode(HttpStatus.NO_CONTENT)
+  async revoke(@Req() req: Request, @Res() res: Response) {
+    this.auth.assertOrigin(req);
+    await this.auth.signOut(req, res);
+    res.status(HttpStatus.NO_CONTENT).send();
+  }
+}
diff --git a/packages/backend/server/src/core/auth/a2d2/error.ts b/packages/backend/server/src/core/auth/a2d2/error.ts
