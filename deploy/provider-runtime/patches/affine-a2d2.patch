+import importlib.util
+from pathlib import Path
+import threading
+import json
+import hashlib
+import unittest
+import urllib.error
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+spec = importlib.util.spec_from_file_location('verify_runtime', Path(__file__).with_name('verify_runtime.py'))
+runtime = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(runtime)
+
+class RuntimeProbeTests(unittest.TestCase):
+    def probe(self, root_status=200, info_version='0.27.4', **options):
+        class Handler(BaseHTTPRequestHandler):
+            def do_POST(self):
+                data = json.loads(self.rfile.read(int(self.headers['Content-Length'])))
+                self.send_response(200)
+                self.send_header('Set-Cookie', 'identity=' + data['email'] + '; Path=/; HttpOnly')
+                self.end_headers(); self.wfile.write(b'{}')
+            def do_GET(self):
+                if self.path.startswith('/api/workspaces/'):
+                    allowed = self.headers.get('Cookie') == 'identity=owner@example.com'
+                    self.send_response(200 if allowed else 403)
+                    self.send_header('Content-Type', 'application/octet-stream')
+                    self.end_headers(); self.wfile.write(b'saved-document' if allowed else b'denied')
+                    return
+                if self.path == '/info':
+                    body = ('{"compatibility":"' + info_version + '","type":"selfhosted"}').encode()
+                    self.send_response(200)
+                    self.send_header('Content-Type', 'application/json')
+                else:
+                    body = b'<html>AFFiNE</html>'
+                    self.send_response(root_status)
+                    self.send_header('Content-Type', 'text/html')
+                self.end_headers()
+                self.wfile.write(body)
+            def log_message(self, *args): pass
+        server = HTTPServer(('127.0.0.1', 0), Handler)
+        thread = threading.Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        try:
+            return runtime.probe('http://127.0.0.1:' + str(server.server_port), **options)
+        finally:
+            server.shutdown(); server.server_close(); thread.join()
+
+    def test_html_and_version_are_both_required(self):
+        result = self.probe()
+        self.assertEqual(result['uiStatus'], 200)
+        self.assertEqual(result['version'], '0.27.4')
+        self.assertEqual(result['login'], 'not-tested')
+
+    def test_liveness_success_cannot_hide_ui_failure(self):
+        with self.assertRaises(urllib.error.HTTPError) as failure: self.probe(root_status=500)
+        self.assertEqual(failure.exception.code, 500)
+        failure.exception.close()
+
+    def test_login_document_and_outsider_denial(self):
+        result = self.probe(workspace='workspace', doc='doc', email='owner@example.com', password='test-only', other_email='outsider@example.com', other_password='test-only')
+        self.assertEqual(result['documentSha256'], hashlib.sha256(b'saved-document').hexdigest())
+        self.assertEqual(result['anonymousDenied'], 403)
+        self.assertEqual(result['otherAccount']['deniedStatus'], 403)
+
+    def test_changed_document_does_not_pass_restart_check(self):
+        with self.assertRaisesRegex(RuntimeError, 'document-hash-mismatch'):
+            self.probe(workspace='workspace', doc='doc', email='owner@example.com', password='test-only', expected='wrong')
+
+    def test_unexpected_image_version_is_rejected(self):
+        with self.assertRaisesRegex(RuntimeError, 'version-mismatch'):
+            self.probe(info_version='different')
+
+if __name__ == '__main__': unittest.main()
