+    }
+    const isLoopback =
+      parsed.hostname === '127.0.0.1' ||
+      parsed.hostname === 'localhost' ||
+      parsed.hostname === '::1';
+    if (
+      parsed.protocol !== 'https:' &&
+      !(isLoopback && parsed.protocol === 'http:')
+    ) {
+      throw new Error(`AFFINE_A2D2_${label.toUpperCase()} must use HTTPS.`);
+    }
+    if (
+      parsed.username ||
+      parsed.password ||
+      parsed.search ||
+      parsed.hash ||
+      (parsed.pathname !== '/' && parsed.pathname !== '')
+    ) {
+      throw new Error(`AFFINE_A2D2_${label.toUpperCase()} must be an origin.`);
+    }
+    return parsed.origin;
+  }
+
+  private async request(
+    path: string,
+    input: Record<string, string>,
+    expectEmpty = false
+  ): Promise<A2d2BrokerPrincipal> {
+    if (!this.enabled || !this.brokerOrigin) {
+      throw new A2d2AuthError('broker_unavailable');
+    }
+
+    const body = JSON.stringify(input);
+    const timestamp = Math.floor(Date.now() / 1000).toString();
+    const bodyHash = createHash('sha256').update(body).digest('hex');
+    const signature = createHmac('sha256', this.config.a2d2Auth.engineSecret)
+      .update(`${timestamp}\n${bodyHash}`)
+      .digest('hex');
+
+    let response: Response;
+    try {
+      response = await fetch(new URL(path, this.brokerOrigin), {
+        method: 'POST',
+        headers: {
+          'content-type': 'application/json',
+          'x-a2d2-engine-timestamp': timestamp,
+          'x-a2d2-engine-signature': signature,
+        },
+        body,
+        redirect: 'manual',
+        signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+      });
+    } catch {
+      throw new A2d2AuthError('broker_unavailable');
+    }
+
+    if (response.status >= 300 && response.status < 400) {
+      await response.body?.cancel();
+      throw new A2d2AuthError('broker_unavailable');
+    }
+    if (expectEmpty && response.status === 204) {
+      return undefined as never;
+    }
+
+    const payload = await this.readBoundedJson(response);
+    if (!response.ok) {
+      const parsed = BrokerErrorSchema.safeParse(payload);
+      throw new A2d2AuthError(
+        parsed.success
+          ? (parsed.data.error as A2d2AuthErrorCode)
+          : 'broker_unavailable'
+      );
+    }
+
+    const parsed = BrokerPrincipalSchema.safeParse(payload);
+    if (!parsed.success || parsed.data.expires_at * 1000 <= Date.now()) {
+      throw new A2d2AuthError('broker_unavailable');
+    }
+    return parsed.data;
+  }
+
+  private async readBoundedJson(response: Response): Promise<unknown> {
+    if (!response.body) return null;
+    const reader = response.body.getReader();
+    const chunks: Uint8Array[] = [];
+    let size = 0;
+    try {
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) break;
+        size += value.byteLength;
+        if (size > MAX_RESPONSE_BYTES) {
+          await reader.cancel();
+          throw new A2d2AuthError('broker_unavailable');
+        }
+        chunks.push(value);
+      }
+    } catch (error) {
+      if (error instanceof A2d2AuthError) throw error;
+      throw new A2d2AuthError('broker_unavailable');
+    }
+    const bytes = new Uint8Array(size);
+    let offset = 0;
+    for (const chunk of chunks) {
+      bytes.set(chunk, offset);
+      offset += chunk.byteLength;
+    }
+    try {
+      return JSON.parse(new TextDecoder().decode(bytes));
+    } catch {
+      throw new A2d2AuthError('broker_unavailable');
+    }
+  }
+}
