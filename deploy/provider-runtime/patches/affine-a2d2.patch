+
+describe('A2D2 managed workspace routing', () => {
+  test('uses the full workspace shell route', () => {
+    expect(managedWorkspacePath('71c0151b-cff6-44fc-9592-b8dbdbcd632a')).toBe(
+      '/workspace/71c0151b-cff6-44fc-9592-b8dbdbcd632a/all'
+    );
+  });
+
+  test('preserves documents only inside the managed workspace', () => {
+    const workspaceId = '71c0151b-cff6-44fc-9592-b8dbdbcd632a';
+    expect(
+      isManagedWorkspacePath(workspaceId, `/workspace/${workspaceId}/doc-1`)
+    ).toBe(true);
+    expect(
+      isManagedWorkspacePath(
+        workspaceId,
+        '/workspace/9ca5aba0-311f-48a8-acd1-89e55bb05718/doc-1'
+      )
+    ).toBe(false);
+    expect(isManagedWorkspacePath(workspaceId, '/all')).toBe(false);
+  });
+});
diff --git a/packages/frontend/apps/web/src/a2d2-managed-auth.ts b/packages/frontend/apps/web/src/a2d2-managed-auth.ts
new file mode 100644
index 0000000..7ce218d
--- /dev/null
+++ b/packages/frontend/apps/web/src/a2d2-managed-auth.ts
@@ -0,0 +1,70 @@
+const WORKSPACE_STORAGE_KEY = 'a2d2-managed-workspace-id';
+const WORKSPACE_ID =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+
+type A2d2LaunchResult = {
+  authenticated: true;
+  expires_at: number;
+  workspace_id: string;
+};
+
+declare global {
+  interface Window {
+    a2d2Engine?: Readonly<{
+      launch(): Promise<A2d2LaunchResult>;
+    }>;
+  }
+}
+
+function validWorkspaceId(value: unknown): value is string {
+  return typeof value === 'string' && WORKSPACE_ID.test(value);
+}
+
+async function hasManagedSession() {
+  const response = await fetch('/api/auth/session', {
+    cache: 'no-store',
+    credentials: 'include',
+  });
+  if (!response.ok) return false;
+  const body = (await response.json()) as { user?: { id?: unknown } | null };
+  return typeof body.user?.id === 'string';
+}
+
+/**
+ * Establish the provider-managed A2D2 session before AFFiNE initializes its
+ * cached auth/router state. Normal web builds remain unchanged when the native
+ * bridge and its previously verified workspace marker are both absent.
+ */
+export async function prepareA2d2ManagedLaunch(): Promise<string | null> {
+  const bridge = window.a2d2Engine;
+  const storedWorkspace = localStorage.getItem(WORKSPACE_STORAGE_KEY);
+
+  if (!bridge) {
+    return validWorkspaceId(storedWorkspace) ? storedWorkspace : null;
+  }
+
+  if (validWorkspaceId(storedWorkspace) && (await hasManagedSession())) {
+    return storedWorkspace;
+  }
+
+  localStorage.removeItem(WORKSPACE_STORAGE_KEY);
+  const launch = await bridge.launch();
+  if (
+    launch.authenticated !== true ||
+    !Number.isSafeInteger(launch.expires_at) ||
+    launch.expires_at <= Math.floor(Date.now() / 1000) ||
+    !validWorkspaceId(launch.workspace_id)
+  ) {
+    throw new Error('A2D2 managed session response is invalid');
+  }
+  localStorage.setItem(WORKSPACE_STORAGE_KEY, launch.workspace_id);
+  return launch.workspace_id;
+}
+
+export function managedWorkspacePath(workspaceId: string) {
+  return `/workspace/${workspaceId}/all`;
+}
+
+export function isManagedWorkspacePath(workspaceId: string, pathname: string) {
+  return pathname.startsWith(`/workspace/${workspaceId}/`);
+}
