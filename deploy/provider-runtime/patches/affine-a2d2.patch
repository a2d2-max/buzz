diff --git a/packages/backend/server/src/core/doc/a2d2/controller.ts b/packages/backend/server/src/core/doc/a2d2/controller.ts
new file mode 100644
index 0000000..a72ece6
--- /dev/null
+++ b/packages/backend/server/src/core/doc/a2d2/controller.ts
@@ -0,0 +1,131 @@
+import {
+  Controller,
+  Get,
+  Param,
+  Post,
+  RawBody,
+  Req,
+  Res,
+} from '@nestjs/common';
+import type { Request, Response } from 'express';
+
+import { Config } from '../../../base/config/config';
+import { Public } from '../../auth/guard';
+import { PgWorkspaceDocStorageAdapter } from '../adapters/workspace';
+import { DatabaseDocReader } from '../reader';
+import { bearerToken, parseTokenAllowlist, tokenMatchesAllowlist } from './token';
+
+const ID_SHAPE = /^[A-Za-z0-9_:-]{1,128}$/;
+const MAX_UPDATE_BYTES = 8 * 1024 * 1024;
+
+/**
+ * A2D2 동기화 워커가 쓰는 **블록 단위** 문서 통로.
+ *
+ * 마크다운을 안 거친다. 마크다운 통로는 콜아웃을 지우고 코드블록을 왕복마다
+ * 늘리고 블록 안 줄바꿈을 못 적는다(실측). 여기는 Yjs 업데이트를 그대로
+ * 주고받아서 그 문제가 생기지 않고, **바뀐 게 없으면 업데이트가 비어서
+ * 서버가 아무것도 안 한다** — 멱등성이 공짜로 따라온다.
+ *
+ * 쓰는 사람은 늘 싱크 봇으로 못 박는다. 그래야 봇이 쓴 글을 되받지 않는다.
+ */
+@Controller('/api/a2d2/docs')
+export class A2d2DocController {
+  constructor(
+    private readonly config: Config,
+    private readonly reader: DatabaseDocReader,
+    private readonly storage: PgWorkspaceDocStorageAdapter
+  ) {}
+
+  @Public()
+  @Get('/:workspaceId/:docId/yjs')
+  async read(
+    @Req() req: Request,
+    @Res() res: Response,
+    @Param('workspaceId') workspaceId: string,
+    @Param('docId') docId: string
+  ) {
+    if (!this.authorize(req, res)) return;
+    if (!this.validIds(res, workspaceId, docId)) return;
+
+    const doc = await this.reader.getDoc(workspaceId, docId);
+    if (!doc) {
+      res.status(404).json({ error: 'doc_not_found' });
+      return;
+    }
+    res.setHeader('Cache-Control', 'no-store');
+    res.setHeader('Content-Type', 'application/octet-stream');
+    res.setHeader('x-doc-timestamp', doc.timestamp.toString());
+    if (doc.editor) res.setHeader('x-doc-editor-id', doc.editor);
+    res.send(doc.bin);
+  }
+
+  @Public()
+  @Post('/:workspaceId/:docId/yjs')
+  async write(
+    @Req() req: Request,
+    @Res() res: Response,
+    @Param('workspaceId') workspaceId: string,
+    @Param('docId') docId: string,
+    @RawBody() update: Buffer | undefined
+  ) {
+    if (!this.authorize(req, res)) return;
+    if (!this.validIds(res, workspaceId, docId)) return;
+
+    const editor = this.config.a2d2Docs.serviceEditorId.trim();
+    if (!editor) {
+      // 편집자를 못 박지 못하면 되받기를 거를 수 없다. 열지 않고 멈춘다.
+      res.status(503).json({ error: 'a2d2_docs_editor_unset' });
+      return;
+    }
+    if (!update || update.length === 0) {
+      res.status(400).json({ error: 'empty_update' });
+      return;
+    }
+    if (update.length > MAX_UPDATE_BYTES) {
+      res.status(413).json({ error: 'update_too_large' });
+      return;
+    }
+
+    const timestamp = await this.storage.pushDocUpdates(
+      workspaceId,
+      docId,
+      [new Uint8Array(update)],
+      editor
+    );
+    res.setHeader('Cache-Control', 'no-store');
+    // timestamp 0 은 「받았지만 바꿀 게 없었다」는 뜻이다. 오류가 아니다.
+    res.json({ applied: timestamp !== 0, timestamp, editor });
+  }
+
+  private authorize(req: Request, res: Response): boolean {
+    const { enabled, serviceTokenSha256, serviceTokenSha256s } =
+      this.config.a2d2Docs;
+    if (!enabled) {
+      res.status(404).json({ error: 'not_found' });
+      return false;
+    }
+    const allowlist = parseTokenAllowlist(
+      serviceTokenSha256,
+      serviceTokenSha256s
+    );
+    if (allowlist.length === 0) {
+      // 설정이 비었거나 깨졌다. 열어 두느니 못 쓰게 한다.
+      res.status(503).json({ error: 'a2d2_docs_auth_unavailable' });
+      return false;
+    }
+    const token = bearerToken(req.headers.authorization);
+    if (!token || !tokenMatchesAllowlist(token, allowlist)) {
+      res.status(403).json({ error: 'a2d2_docs_forbidden' });
+      return false;
+    }
+    return true;
+  }
+
+  private validIds(res: Response, workspaceId: string, docId: string): boolean {
+    if (!ID_SHAPE.test(workspaceId) || !ID_SHAPE.test(docId)) {
+      res.status(400).json({ error: 'invalid_id' });
+      return false;
+    }
+    return true;
+  }
+}
