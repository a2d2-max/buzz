+import './config';
+
+export { A2d2BrokerClient } from './broker';
+export { A2d2SessionController } from './controller';
+export { A2d2AuthError } from './error';
+export { A2d2ManagedAuthService } from './service';
diff --git a/packages/backend/server/src/core/auth/a2d2/service.ts b/packages/backend/server/src/core/auth/a2d2/service.ts
new file mode 100644
index 0000000..dd55c19
--- /dev/null
+++ b/packages/backend/server/src/core/auth/a2d2/service.ts
@@ -0,0 +1,501 @@
+import { createHash, randomBytes, randomUUID } from 'node:crypto';
+
+import { Injectable, Logger } from '@nestjs/common';
+import { Transactional, TransactionHost } from '@nestjs-cls/transactional';
+import type { TransactionalAdapterPrisma } from '@nestjs-cls/transactional-adapter-prisma';
+import type { Request, Response } from 'express';
+import { Array as YArray, Doc as YDoc, encodeStateAsUpdate } from 'yjs';
+
+import { Cache, CryptoHelper, getRequestCookie } from '../../../base';
+import { Models, WorkspaceMemberStatus, WorkspaceRole } from '../../../models';
+import { QuotaStateService } from '../../quota/state';
+import {
+  CSRF_COOKIE_NAME,
+  SESSION_COOKIE_NAME,
+  USER_COOKIE_NAME,
+} from '../input';
+import { sessionUser } from '../service';
+import type { Session } from '../session';
+import { A2d2BrokerClient, type A2d2BrokerPrincipal } from './broker';
+import { A2d2AuthError } from './error';
+
+const SESSION_COOKIE = '__Host-a2d2-affine-session';
+const STATE_COOKIE = '__Host-a2d2-affine-callback-state';
+const STATE_TTL_MS = 60_000;
+const MAX_CONCURRENT_SESSION_CHECKS = 128;
+
+@Injectable()
+export class A2d2ManagedAuthService {
+  private readonly logger = new Logger(A2d2ManagedAuthService.name);
+  private readonly inFlightSessionChecks = new Map<
+    string,
+    Promise<A2d2BrokerPrincipal>
+  >();
+
+  constructor(
+    private readonly crypto: CryptoHelper,
+    private readonly cache: Cache,
+    private readonly broker: A2d2BrokerClient,
+    private readonly models: Models,
+    private readonly txHost: TransactionHost<TransactionalAdapterPrisma>,
+    private readonly quotaState: QuotaStateService
+  ) {}
+
+  private get db() {
+    return this.txHost.tx;
+  }
+
+  get enabled() {
+    return this.broker.enabled;
+  }
+
+  async begin(res: Response) {
+    this.assertEnabled();
+    const state = randomBytes(32).toString('base64url');
+    const hash = this.sha256(state);
+    const stored = await this.cache.setnx(this.stateKey(hash), true, {
+      ttl: STATE_TTL_MS,
+    });
+    if (!stored) {
+      throw new A2d2AuthError('broker_unavailable');
+    }
+    res.cookie(STATE_COOKIE, hash, {
+      httpOnly: true,
+      secure: true,
+      sameSite: 'strict',
+      path: '/',
+      maxAge: STATE_TTL_MS,
+    });
+    return { state, expires_at: new Date(Date.now() + STATE_TTL_MS) };
+  }
+
+  async exchange(
+    req: Request,
+    res: Response,
+    input: { code: string; mountSession: string; state: string }
+  ) {
+    let stage = 'callback_state';
+    try {
+      this.assertEnabled();
+      const stateHash = getRequestCookie(req, STATE_COOKIE);
+      this.clearStateCookie(res);
+      const inputHash = this.sha256(input.state);
+      const storedState = stateHash
+        ? await this.cache.getAndDelete<boolean>(this.stateKey(stateHash))
+        : undefined;
+      if (
+        !stateHash ||
+        !storedState ||
+        !this.crypto.compare(stateHash, inputHash)
+      ) {
+        throw new A2d2AuthError('launch_invalid_or_expired');
+      }
+
+      stage = 'broker_exchange';
+      const brokerPrincipal = await this.broker.exchange({
+        code: input.code,
+        mountSession: input.mountSession,
+        callbackState: input.state,
+      });
+      stage = 'principal_sync';
+      const principal = await this.syncPrincipal(brokerPrincipal);
+      stage = 'quota_reconcile';
+      await this.quotaState.reconcileUserQuotaState(principal.userId);
+      stage = 'session_cookie';
+      this.setSessionCookie(res, brokerPrincipal);
+      this.logger.log('a2d2_managed_exchange_completed');
+      return {
+        authenticated: true as const,
+        workspace_id: principal.workspaceId,
+        expires_at: brokerPrincipal.expires_at,
+      };
+    } catch (error) {
+      const reason =
+        error instanceof A2d2AuthError ? error.code : 'internal_failure';
+      this.logger.warn(
+        `a2d2_managed_exchange_failed stage=${stage} reason=${reason}`
+      );
+      throw error;
+    }
+  }
+
+  async authenticate(req: Request, res?: Response): Promise<Session | null> {
+    if (!this.enabled) return null;
+    const encryptedToken = getRequestCookie(req, SESSION_COOKIE);
+    if (!encryptedToken) return null;
+
+    let cookie: { sessionToken: string; principalKey: string };
+    try {
+      cookie = this.decryptSessionCookie(encryptedToken);
+    } catch {
+      if (res) this.clearSessionCookies(res);
+      throw new A2d2AuthError('scope_or_membership_denied');
+    }
+
+    try {
+      const brokerPrincipal = await this.checkBrokerSession(
+        cookie.sessionToken
+      );
+      if (brokerPrincipal.principal_key !== cookie.principalKey) {
+        throw new A2d2AuthError('scope_or_membership_denied');
+      }
+      const principal = await this.syncPrincipal(brokerPrincipal);
+      if (!principal.active || principal.user.disabled) {
+        throw new A2d2AuthError('scope_or_membership_denied');
+      }
+      const expiresAt = new Date(brokerPrincipal.expires_at * 1000);
+      const sessionId = `a2d2:${this.sha256(cookie.sessionToken).slice(0, 32)}`;
+      req.authType = 'a2d2';
+      req.session = {
+        id: sessionId,
+        sessionId,
+        userId: principal.userId,
+        expiresAt,
+        signInClientVersion: null,
+        refreshClientVersion: null,
+        createdAt: principal.createdAt,
+        user: sessionUser(principal.user),
+      };
+      return req.session;
+    } catch (error) {
+      if (
+        error instanceof A2d2AuthError &&
+        error.code === 'scope_or_membership_denied'
+      ) {
+        await this.disablePrincipal(cookie.principalKey);
+      }
+      if (
+        res &&
+        error instanceof A2d2AuthError &&
+        [
+          'session_invalid_or_expired',
+          'session_scope_mismatch',
+          'scope_or_membership_denied',
+        ].includes(error.code)
+      ) {
+        this.clearSessionCookies(res);
+      }
+      throw error;
+    }
+  }
+
+  async signOut(req: Request, res: Response) {
+    const encryptedToken = getRequestCookie(req, SESSION_COOKIE);
+    this.clearSessionCookies(res);
+    if (!encryptedToken) return;
+    try {
+      const cookie = this.decryptSessionCookie(encryptedToken);
+      await this.broker.revoke(cookie.sessionToken);
+    } catch (error) {
+      if (
+        error instanceof A2d2AuthError &&
+        (error.code === 'session_invalid_or_expired' ||
+          error.code === 'session_scope_mismatch' ||
+          error.code === 'launch_invalid_or_expired' ||
+          error.code === 'scope_or_membership_denied')
+      ) {
+        return;
+      }
+      throw error;
+    }
+  }
+
+  assertRequestAllowed(req: Request) {
+    if (!this.enabled) return;
+    const path = req.path;
+    if (
+      path.startsWith('/api/oauth') ||
+      path.startsWith('/api/setup') ||
+      (path.startsWith('/api/auth/') &&
+        path !== '/api/auth/session' &&
+        path !== '/api/auth/methods' &&
+        path !== '/api/auth/sign-out')
+    ) {
+      throw new A2d2AuthError('scope_or_membership_denied');
+    }
+  }
+
+  assertOrigin(req: Request) {
+    if (req.get('origin') !== this.broker.origin) {
+      throw new A2d2AuthError('invalid_request');
+    }
+  }
+
+  assertManagedUser(userId: string) {
+    return this.db.a2d2PrincipalBinding.findUnique({
+      where: { userId },
+      select: { userId: true },
+    });
+  }
+
+  clearStateCookie(res: Response) {
+    res.clearCookie(STATE_COOKIE, {
+      secure: true,
+      sameSite: 'strict',
+      path: '/',
+    });
+  }
+
+  private stateKey(hash: string) {
+    return `a2d2:affine:callback_state:${hash}`;
+  }
+
+  private async checkBrokerSession(sessionToken: string) {
+    const key = this.sha256(sessionToken);
+    const inFlight = this.inFlightSessionChecks.get(key);
+    if (inFlight) return await inFlight;
+    if (this.inFlightSessionChecks.size >= MAX_CONCURRENT_SESSION_CHECKS) {
+      throw new A2d2AuthError('broker_unavailable');
+    }
+
+    const check = this.broker.check(sessionToken);
+    this.inFlightSessionChecks.set(key, check);
+    try {
+      return await check;
+    } finally {
+      if (this.inFlightSessionChecks.get(key) === check) {
+        this.inFlightSessionChecks.delete(key);
+      }
+    }
+  }
+
+  private setSessionCookie(res: Response, principal: A2d2BrokerPrincipal) {
+    const expires = new Date(principal.expires_at * 1000);
+    res.clearCookie(SESSION_COOKIE_NAME, { path: '/' });
+    res.clearCookie(USER_COOKIE_NAME, { path: '/' });
+    res.cookie(
+      SESSION_COOKIE,
+      this.crypto.encrypt(
+        JSON.stringify({
+          v: 1,
+          session_token: principal.session_token,
+          principal_key: principal.principal_key,
+        })
+      ),
+      {
+        httpOnly: true,
+        secure: true,
+        sameSite: 'strict',
+        path: '/',
+        expires,
+      }
+    );
+    res.cookie(CSRF_COOKIE_NAME, randomUUID(), {
+      httpOnly: false,
+      secure: true,
+      sameSite: 'strict',
+      path: '/',
+      expires,
+    });
+  }
+
+  clearSessionCookies(res: Response) {
+    res.clearCookie(SESSION_COOKIE, {
+      secure: true,
+      sameSite: 'strict',
+      path: '/',
+    });
+    res.clearCookie(CSRF_COOKIE_NAME, { path: '/' });
+  }
+
+  @Transactional()
+  private async syncPrincipal(broker: A2d2BrokerPrincipal) {
+    await this.db.$executeRaw`
+      SELECT pg_advisory_xact_lock(
+        hashtextextended(${`a2d2:affine:${broker.community_id}`}, 0)
+      )
+    `;
+
+    let binding = await this.db.a2d2CommunityBinding.findUnique({
+      where: { communityId: broker.community_id },
+    });
+    let principal = await this.db.a2d2PrincipalBinding.findUnique({
+      where: {
+        communityId_pubkey: {
+          communityId: broker.community_id,
+          pubkey: broker.pubkey,
+        },
+      },
+      include: { user: true },
+    });
+
+    if (principal && principal.principalKey !== broker.principal_key) {
+      throw new A2d2AuthError('scope_or_membership_denied');
+    }
+
+    if (!binding) {
+      if (broker.role !== 'owner') {
+        throw new A2d2AuthError('community_not_provisioned');
+      }
+      const user = principal?.user ?? (await this.createManagedUser(broker));
+      const workspace = await this.models.workspace.create(user.id);
+      await this.models.workspace.update(workspace.id, { name: 'A2D2' });
+      binding = await this.db.a2d2CommunityBinding.create({
+        data: {
+          communityId: broker.community_id,
+          workspaceId: workspace.id,
+        },
+      });
+      principal = await this.db.a2d2PrincipalBinding.create({
+        data: {
+          communityId: binding.communityId,
+          workspaceId: binding.workspaceId,
+          pubkey: broker.pubkey,
+          principalKey: broker.principal_key,
+          userId: user.id,
+          role: broker.role,
+          active: true,
+        },
+        include: { user: true },
+      });
+      await this.ensureManagedWorkspaceInitialized(
+        binding.workspaceId,
+        principal.userId
+      );
+      return principal;
+    }
+
+    if (!principal) {
+      const user = await this.createManagedUser(broker);
+      principal = await this.db.a2d2PrincipalBinding.create({
+        data: {
+          communityId: binding.communityId,
+          workspaceId: binding.workspaceId,
+          pubkey: broker.pubkey,
+          principalKey: broker.principal_key,
+          userId: user.id,
+          role: broker.role,
+          active: true,
+        },
+        include: { user: true },
+      });
+    }
+
+    await this.syncWorkspaceRole(
+      binding.workspaceId,
+      principal.userId,
+      principal.role,
+      broker.role
+    );
+    if (principal.role !== broker.role || !principal.active) {
+      principal = await this.db.a2d2PrincipalBinding.update({
+        where: {
+          communityId_pubkey: {
+            communityId: broker.community_id,
+            pubkey: broker.pubkey,
+          },
+        },
+        data: { role: broker.role, active: true },
+        include: { user: true },
+      });
+    }
+    await this.ensureManagedWorkspaceInitialized(
+      binding.workspaceId,
+      principal.userId
+    );
+    return principal;
+  }
+
+  private async ensureManagedWorkspaceInitialized(
+    workspaceId: string,
+    editorId: string
+  ) {
+    if (await this.models.doc.exists(workspaceId, workspaceId)) return;
+
+    const rootDoc = new YDoc({ guid: workspaceId });
+    rootDoc.getMap('meta').set('pages', new YArray());
+    await this.models.doc.upsert({
+      spaceId: workspaceId,
+      docId: workspaceId,
+      blob: Buffer.from(encodeStateAsUpdate(rootDoc)),
+      timestamp: Date.now(),
+      editorId,
+    });
+
+    if (!(await this.models.doc.exists(workspaceId, workspaceId))) {
+      throw new A2d2AuthError('broker_unavailable');
+    }
+  }
+
+  private async createManagedUser(broker: A2d2BrokerPrincipal) {
+    const keyHash = createHash('sha256')
+      .update(`${broker.community_id}:${broker.pubkey}`)
+      .digest('hex')
+      .slice(0, 20);
+    const community = broker.community_id.replaceAll('-', '').slice(0, 12);
+    return await this.db.user.create({
+      data: {
+        name: `A2D2 ${broker.pubkey.slice(0, 12)}`,
+        email: `a2d2+${community}.${broker.pubkey.slice(0, 12)}.${keyHash}@internal.invalid`,
+        password: null,
+        emailVerifiedAt: new Date(),
+        registered: true,
+      },
+    });
+  }
+
+  private async syncWorkspaceRole(
+    workspaceId: string,
+    userId: string,
+    previousRole: string,
+    role: A2d2BrokerPrincipal['role']
+  ) {
+    if (role === 'owner') {
+      const currentOwner = await this.db.a2d2PrincipalBinding.findFirst({
+        where: {
+          workspaceId,
+          role: 'owner',
+          active: true,
+          userId: { not: userId },
+        },
+      });
+      if (currentOwner) throw new A2d2AuthError('community_owner_conflict');
+      await this.models.workspaceUser.setOwner(workspaceId, userId);
+      return;
+    }
+    if (previousRole === 'owner') {
+      throw new A2d2AuthError('community_owner_conflict');
+    }
+    await this.models.workspaceUser.set(
+      workspaceId,
+      userId,
+      role === 'admin' ? WorkspaceRole.Admin : WorkspaceRole.Collaborator,
+      { status: WorkspaceMemberStatus.Accepted }
+    );
+  }
+
+  private async disablePrincipal(principalKey: string) {
+    await this.db.a2d2PrincipalBinding.updateMany({
+      where: { principalKey },
+      data: { active: false },
+    });
+  }
+
+  private decryptSessionCookie(encrypted: string) {
+    const value = JSON.parse(this.crypto.decrypt(encrypted)) as unknown;
+    if (
+      !value ||
+      typeof value !== 'object' ||
+      !('v' in value) ||
+      value.v !== 1 ||
+      !('session_token' in value) ||
+      typeof value.session_token !== 'string' ||
+      !('principal_key' in value) ||
+      typeof value.principal_key !== 'string'
+    ) {
+      throw new A2d2AuthError('scope_or_membership_denied');
+    }
+    return {
+      sessionToken: value.session_token,
+      principalKey: value.principal_key,
+    };
+  }
+
+  private sha256(value: string) {
+    return createHash('sha256').update(value).digest('hex');
+  }
+
+  private assertEnabled() {
+    if (!this.enabled) throw new A2d2AuthError('broker_unavailable');
+  }
+}
