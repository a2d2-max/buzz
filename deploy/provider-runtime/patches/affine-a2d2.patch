+#!/bin/sh
+set -eu
+cd "$(dirname "$0")"
+config_file=${1:?Usage: ./start.sh .env.remote}
+[ -f "$config_file" ] || { echo 'Environment file missing' >&2; exit 1; }
+docker compose --env-file "$config_file" -f compose.yml config --quiet
+if docker compose --env-file "$config_file" -f compose.yml config --images | grep -Ev '(^sha256:[0-9a-f]{64}$|@sha256:[0-9a-f]{64}$)'; then
+  echo 'All remote images must use an exact local image ID or registry digest' >&2
+  exit 1
+fi
+affine_image=$(awk -F= '$1 == "AFFINE_IMAGE" { print substr($0, index($0, "=") + 1) }' "$config_file")
+if ! printf '%s\n' "$affine_image" | grep -Eq '^sha256:[0-9a-f]{64}$'; then
+  echo 'AFFINE_IMAGE must be the exact local sha256 image ID from the handoff manifest' >&2
+  exit 1
+fi
+docker image inspect "$affine_image" >/dev/null
+docker compose --env-file "$config_file" -f compose.yml pull postgres redis
+docker compose --env-file "$config_file" -f compose.yml up -d
