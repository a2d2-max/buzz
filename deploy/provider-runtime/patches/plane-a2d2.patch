+        )
+        self.assertEqual(partial_conflict.status_code, 409)
+        self.assertEqual(User.objects.count(), before)
+        self.assertEqual(A2D2ManagedPrincipal.objects.count(), 0)
+        self.assertEqual(ProjectMember.objects.filter(project=project).count(), 1)
+
+    def test_service_credential_requires_active_admin_scope_on_exact_binding(self):
