+import { afterEach, describe, expect, test, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({ currentUser: vi.fn() }));
+
+vi.mock("@/services/user.service", () => ({
+  UserService: class {
+    currentUser = mocks.currentUser;
+  },
+}));
+
+import { beforeHandleMessage } from "@/lib/auth";
+
+const payload = (userId: string, cookie: string) =>
+  ({ context: { userId, cookie } }) as Parameters<typeof beforeHandleMessage>[0];
+
+afterEach(() => {
+  mocks.currentUser.mockReset();
+});
+
+describe("managed live session revalidation", () => {
+  test("coalesces simultaneous checks for the same managed session", async () => {
+    let resolve!: (value: { id: string; display_name: string }) => void;
+    mocks.currentUser.mockReturnValue(
+      new Promise((done) => {
+        resolve = done;
+      })
+    );
+
+    const first = beforeHandleMessage(payload("user-1", "session=one"));
+    const second = beforeHandleMessage(payload("user-1", "session=one"));
+    expect(mocks.currentUser).toHaveBeenCalledTimes(1);
+    resolve({ id: "user-1", display_name: "One" });
+    await expect(Promise.all([first, second])).resolves.toHaveLength(2);
+  });
+
+  test("fails closed once distinct in-flight checks reach the bounded capacity", async () => {
+    let resolve!: (value: { id: string; display_name: string }) => void;
+    const blocked = new Promise<{ id: string; display_name: string }>((done) => {
+      resolve = done;
+    });
+    mocks.currentUser.mockReturnValue(blocked);
+
+    const inFlight = Array.from({ length: 128 }, (_, index) =>
+      beforeHandleMessage(payload(`user-${index}`, `session=${index}`))
+    );
+    await expect(beforeHandleMessage(payload("user-overflow", "session=overflow"))).rejects.toMatchObject({
+      code: "AUTH_CHECK_CAPACITY",
+    });
+    expect(mocks.currentUser).toHaveBeenCalledTimes(128);
+
+    resolve({ id: "unused", display_name: "Unused" });
+    await Promise.allSettled(inFlight);
+  });
+});
