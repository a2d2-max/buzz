+import re
+from dataclasses import dataclass
+from uuid import UUID
+
+from django.db import transaction
+
+from plane.db.models import (
+    A2D2ManagedPrincipal,
+    A2D2ManagedWorkspace,
+    APIToken,
+    Profile,
+    Project,
+    ProjectMember,
+    User,
+    Workspace,
+    WorkspaceMember,
+)
+
+from .principals import (
+    _community_lock,
+    _workspace_role,
+    ensure_managed_profile,
+    expected_principal_key,
+)
+from .resolver import PUBKEY_RE
+
+
+MAX_BACKFILL_PRINCIPALS = 1000
+
+
+class BackfillError(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class BackfillPrincipal:
+    pubkey: str
+    user_id: UUID
+    role: str
+
+
+@dataclass(frozen=True)
+class BackfillManifest:
+    community_id: UUID
+    workspace_id: UUID
+    workspace_slug: str
+    project_id: UUID
+    principals: tuple[BackfillPrincipal, ...]
+
+
+def parse_backfill_manifest(data) -> BackfillManifest:
+    if not isinstance(data, dict) or set(data) != {
+        "community_id",
+        "workspace_id",
+        "workspace_slug",
+        "project_id",
+        "principals",
+    }:
+        raise BackfillError("invalid_manifest")
+    workspace_slug = data["workspace_slug"]
+    principals = data["principals"]
+    if (
+        not isinstance(workspace_slug, str)
+        or re.fullmatch(r"[A-Za-z0-9_-]{1,48}", workspace_slug) is None
+        or not isinstance(principals, list)
+        or not 1 <= len(principals) <= MAX_BACKFILL_PRINCIPALS
+    ):
+        raise BackfillError("invalid_manifest")
+    try:
+        community_id = UUID(str(data["community_id"]))
+        workspace_id = UUID(str(data["workspace_id"]))
+        project_id = UUID(str(data["project_id"]))
+    except (TypeError, ValueError):
+        raise BackfillError("invalid_manifest") from None
+
+    parsed: list[BackfillPrincipal] = []
+    for principal in principals:
+        if (
+            not isinstance(principal, dict)
+            or set(principal) != {"pubkey", "user_id", "role"}
+            or not isinstance(principal["pubkey"], str)
+            or PUBKEY_RE.fullmatch(principal["pubkey"]) is None
+            or principal["role"] not in {"owner", "admin", "member"}
+        ):
+            raise BackfillError("invalid_manifest")
+        try:
+            user_id = UUID(str(principal["user_id"]))
+        except (TypeError, ValueError):
+            raise BackfillError("invalid_manifest") from None
+        parsed.append(
+            BackfillPrincipal(
+                pubkey=principal["pubkey"],
+                user_id=user_id,
+                role=principal["role"],
+            )
+        )
+    if (
+        len({principal.pubkey for principal in parsed}) != len(parsed)
+        or len({principal.user_id for principal in parsed}) != len(parsed)
+        or sum(principal.role == "owner" for principal in parsed) != 1
+    ):
+        raise BackfillError("invalid_manifest")
+    return BackfillManifest(
+        community_id=community_id,
+        workspace_id=workspace_id,
+        workspace_slug=workspace_slug,
+        project_id=project_id,
+        principals=tuple(parsed),
+    )
+
+
+@transaction.atomic
+def backfill_existing_principals(manifest: BackfillManifest) -> int:
+    _community_lock(manifest.community_id)
+    workspace = (
+        Workspace.objects.select_for_update().filter(id=manifest.workspace_id, slug=manifest.workspace_slug).first()
+    )
+    project = (
+        Project.objects.select_for_update()
+        .filter(
+            id=manifest.project_id,
+            workspace_id=manifest.workspace_id,
+            network=0,
+            archived_at__isnull=True,
+        )
+        .first()
+    )
+    if workspace is None or project is None:
+        raise BackfillError("provider_scope_conflict")
+
+    users = {
+        user.id: user
+        for user in User.objects.select_for_update().filter(
+            id__in=[principal.user_id for principal in manifest.principals]
+        )
+    }
+    if len(users) != len(manifest.principals):
+        raise BackfillError("provider_user_missing")
+    owner = next(principal for principal in manifest.principals if principal.role == "owner")
+    if workspace.owner_id != owner.user_id:
+        raise BackfillError("workspace_owner_conflict")
+
+    conflicting_bindings = (
+        A2D2ManagedWorkspace.objects.select_for_update()
+        .filter(workspace_id=workspace.id)
+        .exclude(community_id=manifest.community_id)
+    )
+    if conflicting_bindings.exists():
+        raise BackfillError("provider_scope_conflict")
+    binding = A2D2ManagedWorkspace.objects.select_for_update().filter(community_id=manifest.community_id).first()
+    if binding is None:
+        binding = A2D2ManagedWorkspace.objects.create(
+            community_id=manifest.community_id,
+            workspace=workspace,
+            project=project,
+        )
+    elif binding.workspace_id != workspace.id or binding.project_id not in {
+        None,
+        project.id,
+    }:
+        raise BackfillError("provider_scope_conflict")
+    elif binding.project_id is None:
+        binding.project = project
+        binding.save(update_fields=["project", "updated_at"])
+
+    manifest_by_pubkey = {item.pubkey: item for item in manifest.principals}
+    for existing in A2D2ManagedPrincipal.objects.select_for_update().filter(community_id=manifest.community_id):
+        declared = manifest_by_pubkey.get(existing.nostr_pubkey)
+        if (
+            declared is None
+            or existing.user_id != declared.user_id
+            or existing.principal_key != expected_principal_key(manifest.community_id, existing.nostr_pubkey)
+        ):
+            raise BackfillError("principal_mapping_conflict")
+
+    for item in manifest.principals:
+        user = users[item.user_id]
+        if (
+            not user.is_active
+            or user.has_usable_password()
+            or user.is_bot
+            or APIToken.objects.filter(user=user, is_service=True).exists()
+        ):
+            raise BackfillError("provider_user_conflict")
+        expected_key = expected_principal_key(manifest.community_id, item.pubkey)
+        conflicts = (
+            A2D2ManagedPrincipal.objects.select_for_update()
+            .filter(user_id=user.id)
+            .exclude(community_id=manifest.community_id, nostr_pubkey=item.pubkey)
+        )
+        if conflicts.exists():
+            raise BackfillError("principal_mapping_conflict")
+        principal = (
+            A2D2ManagedPrincipal.objects.select_for_update()
+            .filter(community_id=manifest.community_id, nostr_pubkey=item.pubkey)
+            .first()
+        )
+        if principal is not None and (principal.user_id != user.id or principal.principal_key != expected_key):
+            raise BackfillError("principal_mapping_conflict")
+        if (
+            A2D2ManagedPrincipal.objects.select_for_update()
+            .filter(principal_key=expected_key)
+            .exclude(community_id=manifest.community_id, nostr_pubkey=item.pubkey)
+            .exists()
+        ):
+            raise BackfillError("principal_mapping_conflict")
+
+        if not user.is_managed or not user.is_email_verified or user.is_password_autoset:
+            user.is_managed = True
+            user.is_email_verified = True
+            user.is_password_autoset = False
+            user.save(
+                update_fields=[
+                    "is_managed",
+                    "is_email_verified",
+                    "is_password_autoset",
+                    "updated_at",
+                ]
+            )
+        if principal is None:
+            principal = A2D2ManagedPrincipal.objects.create(
+                community_id=manifest.community_id,
+                nostr_pubkey=item.pubkey,
+                principal_key=expected_key,
+                user=user,
+                role=item.role,
+                is_active=True,
+            )
+        elif principal.role != item.role or not principal.is_active:
+            principal.role = item.role
+            principal.is_active = True
+            principal.save(update_fields=["role", "is_active", "updated_at"])
+
+        WorkspaceMember.objects.update_or_create(
+            workspace=workspace,
+            member=user,
+            defaults={"role": _workspace_role(item.role), "is_active": True},
+        )
+        ProjectMember.objects.update_or_create(
+            project=project,
+            member=user,
+            defaults={
+                "workspace": workspace,
+                "role": _workspace_role(item.role),
+                "is_active": True,
+            },
+        )
+        ensure_managed_profile(user, workspace)
+    return len(manifest.principals)
diff --git a/apps/api/plane/a2d2/broker.py b/apps/api/plane/a2d2/broker.py
new file mode 100644
index 0000000000..81491b3792
--- /dev/null
+++ b/apps/api/plane/a2d2/broker.py
@@ -0,0 +1,171 @@
+import hashlib
+import hmac
+import json
+import time
+from dataclasses import dataclass
+from typing import Any
+from uuid import UUID
+
+import requests
+
+from .config import A2D2EngineConfig
+
+
+class BrokerError(Exception):
+    def __init__(self, status_code: int, code: str):
+        super().__init__(code)
+        self.status_code = status_code
+        self.code = code
+
+
+@dataclass(frozen=True)
+class BrokerSession:
+    session_token: str
+    community_id: UUID
+    pubkey: str
+    role: str
+    principal_key: str
+    expires_at: int
+
+
+def _session(value: Any) -> BrokerSession:
+    if not isinstance(value, dict) or set(value) != {
+        "session_token",
+        "community_id",
+        "pubkey",
+        "role",
+        "principal_key",
+        "expires_at",
+    }:
+        raise BrokerError(502, "broker_response_invalid")
+    try:
+        result = BrokerSession(
+            session_token=value["session_token"],
+            community_id=UUID(value["community_id"]),
+            pubkey=value["pubkey"],
+            role=value["role"],
+            principal_key=value["principal_key"],
+            expires_at=value["expires_at"],
+        )
+    except (TypeError, ValueError, AttributeError) as error:
+        raise BrokerError(502, "broker_response_invalid") from error
+    if (
+        not isinstance(result.session_token, str)
+        or not 32 <= len(result.session_token) <= 256
+        or not isinstance(result.expires_at, int)
+        or result.expires_at <= int(time.time())
+        or result.role not in {"owner", "admin", "member"}
+        or len(result.pubkey) != 64
+        or len(result.principal_key) != 64
+    ):
+        raise BrokerError(502, "broker_response_invalid")
+    try:
+        bytes.fromhex(result.pubkey)
+        bytes.fromhex(result.principal_key)
+    except ValueError as error:
+        raise BrokerError(502, "broker_response_invalid") from error
+    return result
+
+
+class BrokerClient:
+    def __init__(self, config: A2D2EngineConfig):
+        self.config = config
+
+    def _post(self, path: str, body: dict[str, Any], *, expect_session: bool) -> BrokerSession | None:
+        encoded = json.dumps(body, separators=(",", ":"), sort_keys=True).encode()
+        timestamp = str(int(time.time()))
+        body_hash = hashlib.sha256(encoded).hexdigest()
+        signature = hmac.new(
+            self.config.secret,
+            f"{timestamp}\n{body_hash}".encode(),
+            hashlib.sha256,
+        ).hexdigest()
+        try:
+            response = requests.post(
+                f"{self.config.broker_url}{path}",
+                data=encoded,
+                headers={
+                    "content-type": "application/json",
+                    "x-a2d2-engine-timestamp": timestamp,
+                    "x-a2d2-engine-signature": signature,
+                },
+                timeout=(2, 5),
+                allow_redirects=False,
+                stream=True,
+            )
+        except requests.RequestException as error:
+            raise BrokerError(503, "broker_unavailable") from error
+        try:
+            payload = bytearray()
+            for chunk in response.iter_content(chunk_size=4096):
+                payload.extend(chunk)
+                if len(payload) > 16 * 1024:
+                    break
+        except requests.RequestException as error:
+            response.close()
+            raise BrokerError(503, "broker_unavailable") from error
+        payload_bytes = bytes(payload)
+        if len(payload_bytes) > 16 * 1024:
+            response.close()
+            raise BrokerError(502, "broker_response_invalid")
+        status_code = response.status_code
+        is_redirect = response.is_redirect
+        response.close()
+        if is_redirect:
+            raise BrokerError(502, "broker_response_invalid")
+        if not 200 <= status_code < 300:
+            try:
+                payload = json.loads(payload_bytes)
+                code = payload.get("error", "broker_denied") if isinstance(payload, dict) else "broker_denied"
+            except (ValueError, UnicodeDecodeError):
+                code = "broker_denied"
+            raise BrokerError(status_code, code)
+        if not expect_session:
+            if status_code != 204 or payload_bytes:
+                raise BrokerError(502, "broker_response_invalid")
+            return None
+        try:
+            return _session(json.loads(payload_bytes))
+        except (ValueError, UnicodeDecodeError) as error:
+            raise BrokerError(502, "broker_response_invalid") from error
+
+    def exchange(self, *, code: str, mount_session: str, callback_state: str) -> BrokerSession:
+        result = self._post(
+            "/api/engine/v1/exchange",
+            {
+                "code": code,
+                "product": "plane",
+                "origin": self.config.origin,
+                "mount_session": mount_session,
+                "callback_state": callback_state,
+            },
+            expect_session=True,
+        )
+        if result is None:
+            raise BrokerError(502, "broker_response_invalid")
+        return result
+
+    def check(self, session_token: str) -> BrokerSession:
+        result = self._post(
+            "/api/engine/v1/session/check",
+            {
+                "session_token": session_token,
+                "product": "plane",
+                "origin": self.config.origin,
+            },
+            expect_session=True,
+        )
+        if result is None:
+            raise BrokerError(502, "broker_response_invalid")
+        return result
+
+    def revoke(self, session_token: str) -> None:
+        self._post(
+            "/api/engine/v1/session/revoke",
+            {
+                "session_token": session_token,
+                "product": "plane",
+                "origin": self.config.origin,
+            },
+            expect_session=False,
+        )
diff --git a/apps/api/plane/a2d2/config.py b/apps/api/plane/a2d2/config.py
new file mode 100644
index 0000000000..de38ff6fb4
--- /dev/null
+++ b/apps/api/plane/a2d2/config.py
@@ -0,0 +1,58 @@
+import os
+import re
+from dataclasses import dataclass
+from urllib.parse import urlparse
+
+
+@dataclass(frozen=True)
+class A2D2EngineConfig:
+    enabled: bool
+    broker_url: str
+    origin: str
+    secret: bytes
+    service_api_token_sha256: str = ""
+
+
+def _is_enabled(value: str | None) -> bool:
+    return (value or "").strip().lower() in {"1", "true", "yes", "on"}
+
+
+def _root_url(value: str, *, loopback_http: bool) -> str | None:
+    parsed = urlparse(value)
+    host = parsed.hostname
+    loopback = host in {"localhost", "127.0.0.1", "::1"}
+    if (
+        not host
+        or parsed.username
+        or parsed.password
+        or parsed.query
+        or parsed.fragment
+        or parsed.path not in {"", "/"}
+        or parsed.scheme not in ({"https", "http"} if loopback_http and loopback else {"https"})
+    ):
+        return None
+    return value.rstrip("/")
+
+
+def load_config() -> A2D2EngineConfig:
+    enabled = _is_enabled(os.environ.get("PLANE_A2D2_AUTH_ENABLED"))
+    broker = _root_url(os.environ.get("PLANE_A2D2_BROKER_URL", ""), loopback_http=True)
+    origin = _root_url(os.environ.get("PLANE_A2D2_ORIGIN", ""), loopback_http=True)
+    secret = os.environ.get("PLANE_A2D2_ENGINE_SECRET", "").encode()
+    service_api_token_sha256 = os.environ.get(
+        "PLANE_A2D2_SERVICE_API_TOKEN_SHA256", ""
+    )
+    if enabled and (
+        broker is None
+        or origin is None
+        or len(secret) < 32
+        or re.fullmatch(r"[0-9a-f]{64}", service_api_token_sha256) is None
+    ):
+        raise ValueError("A2D2 Plane authentication is enabled but incomplete")
+    return A2D2EngineConfig(
+        enabled=enabled,
+        broker_url=broker or "",
+        origin=origin or "",
+        secret=secret,
+        service_api_token_sha256=service_api_token_sha256,
+    )
diff --git a/apps/api/plane/a2d2/middleware.py b/apps/api/plane/a2d2/middleware.py
new file mode 100644
index 0000000000..50fb5e3c5b
--- /dev/null
+++ b/apps/api/plane/a2d2/middleware.py
@@ -0,0 +1,99 @@
+from django.contrib.auth import logout
+from django.http import JsonResponse
+
+from plane.db.models import A2D2ManagedPrincipal
+
+from .broker import BrokerClient, BrokerError
+from .config import load_config
+from .principals import ProvisioningError, deactivate, provision
+
+
+def is_vendor_membership_mutation(method: str, path: str) -> bool:
+    """Return whether managed mode must reject a vendor-owned membership write."""
+    if method not in {"POST", "PUT", "PATCH"}:
+        return False
+    if path == "/api/workspaces/":
+        return True
+    if path.startswith("/api/users/me/workspaces/") and "/invitations/" in path:
+        return True
+    segments = [segment for segment in path.split("/") if segment]
+    if len(segments) < 4 or segments[:2] != ["api", "workspaces"]:
+        return False
+    if segments[3] == "invitations":
+        return True
+    return len(segments) >= 6 and segments[3] == "projects" and segments[5] == "invitations"
+
+
+class A2D2ManagedSessionMiddleware:
+    """Revalidate every managed Plane API request against A2D2 membership."""
+
+    def __init__(self, get_response):
+        self.get_response = get_response
+
+    def __call__(self, request):
+        try:
+            config = load_config()
+        except ValueError:
+            if request.path.startswith("/api/"):
+                return JsonResponse({"error": "a2d2_auth_unavailable"}, status=503)
+            return self.get_response(request)
+        managed_sign_out = request.method == "POST" and request.path == "/auth/sign-out/"
+        if (
+            config.enabled
+            and request.path.startswith("/auth/")
+            and request.path != "/auth/get-csrf-token/"
+            and not managed_sign_out
+        ):
+            return JsonResponse({"error": "a2d2_managed_auth_required"}, status=403)
+        if config.enabled and request.path.startswith("/api/users/api-tokens/"):
+            return JsonResponse({"error": "a2d2_managed_auth_required"}, status=403)
+        if (
+            not config.enabled
+            or request.path.startswith("/api/a2d2/session/")
+            or (not request.path.startswith("/api/") and not managed_sign_out)
+            or not getattr(request.user, "is_authenticated", False)
+        ):
+            return self.get_response(request)
+
+        principal = A2D2ManagedPrincipal.objects.select_related("user").filter(user_id=request.user.id).first()
+        if principal is None:
+            logout(request)
+            return JsonResponse({"error": "a2d2_managed_auth_required"}, status=401)
+
+        token = request.session.get("a2d2_engine_session_token")
+        if not isinstance(token, str):
+            return self._deny(request, principal)
+        try:
+            checked = BrokerClient(config).check(token)
+            if (
+                checked.community_id != principal.community_id
+                or checked.pubkey != principal.nostr_pubkey
+                or checked.principal_key != principal.principal_key
+                or request.session.get("a2d2_engine_community_id") != str(checked.community_id)
+                or request.session.get("a2d2_engine_pubkey") != checked.pubkey
+                or request.session.get("a2d2_engine_principal_key") != checked.principal_key
+            ):
+                return self._deny(request, principal)
+            provision(checked)
+            if managed_sign_out:
+                BrokerClient(config).revoke(token)
+        except BrokerError as error:
+            if error.status_code == 403 and error.code == "scope_or_membership_denied":
+                return self._deny(request, principal)
+            if error.status_code in {401, 403, 410}:
+                logout(request)
+                return JsonResponse({"error": "a2d2_session_expired"}, status=401)
+            return JsonResponse({"error": "a2d2_auth_unavailable"}, status=503)
+        except ProvisioningError:
+            return self._deny(request, principal)
+        if managed_sign_out:
+            return self.get_response(request)
+        if is_vendor_membership_mutation(request.method, request.path):
+            return JsonResponse({"error": "a2d2_membership_managed"}, status=403)
+        return self.get_response(request)
+
+    @staticmethod
+    def _deny(request, principal):
+        deactivate(principal)
+        logout(request)
+        return JsonResponse({"error": "a2d2_session_revoked"}, status=401)
diff --git a/apps/api/plane/a2d2/principals.py b/apps/api/plane/a2d2/principals.py
new file mode 100644
index 0000000000..ec8e4930ec
--- /dev/null
+++ b/apps/api/plane/a2d2/principals.py
@@ -0,0 +1,210 @@
+import hashlib
+from dataclasses import dataclass
+from uuid import UUID
+
+from django.db import connection, transaction
+
+from plane.db.models import (
+    A2D2ManagedPrincipal,
+    A2D2ManagedWorkspace,
+    Profile,
+    ProjectMember,
+    User,
+    Workspace,
+    WorkspaceMember,
+)
+from plane.license.models import Instance
+
+from .broker import BrokerSession
+
+
+class ProvisioningError(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class ManagedIdentity:
+    user: User
+    workspace: Workspace
+    principal: A2D2ManagedPrincipal
+
+
+@dataclass(frozen=True)
+class ManagedPrincipalAuthority:
+    community_id: UUID
+    pubkey: str
+    role: str
+    principal_key: str
+
+
+MANAGED_ONBOARDING_STEP = {
+    "profile_complete": True,
+    "workspace_create": True,
+    "workspace_invite": True,
+    "workspace_join": True,
+}
+
+
+def _workspace_role(role: str) -> int:
+    return 20 if role in {"owner", "admin"} else 15
+
+
+def expected_principal_key(community_id, pubkey: str) -> str:
+    return hashlib.sha256(f"a2d2-engine-principal:v1:{community_id}:plane:{pubkey}".encode()).hexdigest()
+
+
+def ensure_managed_profile(user: User, workspace: Workspace) -> Profile:
+    """Keep a broker-managed principal out of Plane's separate signup flow."""
+    profile, _ = Profile.objects.get_or_create(user=user)
+    changed: list[str] = []
+    desired = {
+        "is_onboarded": True,
+        "is_tour_completed": True,
+        "onboarding_step": MANAGED_ONBOARDING_STEP,
+        "last_workspace_id": workspace.id,
+    }
+    for field, value in desired.items():
+        if getattr(profile, field) != value:
+            setattr(profile, field, value)
+            changed.append(field)
+    if changed:
+        profile.save(update_fields=[*changed, "updated_at"])
+    return profile
+
+
+def _ensure_project_membership(binding: A2D2ManagedWorkspace, user: User, role: str) -> None:
+    project = binding.project
+    if project is None:
+        return
+    if project.workspace_id != binding.workspace_id or project.network != 0 or project.archived_at is not None:
+        raise ProvisioningError("project_binding_conflict")
+    ProjectMember.objects.update_or_create(
+        project=project,
+        member=user,
+        defaults={
+            "workspace": binding.workspace,
+            "role": _workspace_role(role),
+            "is_active": True,
+        },
+    )
+
+
+def _community_lock(community_id) -> None:
+    digest = hashlib.sha256(f"a2d2-plane:{community_id}".encode()).digest()
+    key = int.from_bytes(digest[:8], "big", signed=True)
+    with connection.cursor() as cursor:
+        cursor.execute("SELECT pg_advisory_xact_lock(%s)", [key])
+
+
+@transaction.atomic
+def provision(session: BrokerSession | ManagedPrincipalAuthority) -> ManagedIdentity:
+    _community_lock(session.community_id)
+    if session.principal_key != expected_principal_key(session.community_id, session.pubkey):
+        raise ProvisioningError("principal_mapping_conflict")
+    binding = (
+        A2D2ManagedWorkspace.objects.select_for_update(of=("self",))
+        .select_related("workspace", "project")
+        .filter(community_id=session.community_id)
+        .first()
+    )
+    principal = (
+        A2D2ManagedPrincipal.objects.select_for_update()
+        .select_related("user")
+        .filter(community_id=session.community_id, nostr_pubkey=session.pubkey)
+        .first()
+    )
+
+    if principal is None:
+        user = User(
+            username=f"a2d2-{session.principal_key}",
+            email=f"a2d2+{session.principal_key}@internal.invalid",
+            display_name=f"A2D2 {session.pubkey[:8]}",
+            is_active=True,
+            is_managed=True,
+            is_email_verified=True,
+            is_password_autoset=False,
+        )
+        user.set_unusable_password()
+        user.save()
+        Profile.objects.create(
+            user=user,
+            is_onboarded=True,
+            is_tour_completed=True,
+            onboarding_step=MANAGED_ONBOARDING_STEP,
+        )
+        principal = A2D2ManagedPrincipal.objects.create(
+            community_id=session.community_id,
+            nostr_pubkey=session.pubkey,
+            principal_key=session.principal_key,
+            user=user,
+            role=session.role,
+            is_active=True,
+        )
+    else:
+        user = principal.user
+        if principal.principal_key != session.principal_key or not user.is_managed:
+            raise ProvisioningError("principal_mapping_conflict")
+        if not user.is_active:
+            user.is_active = True
+            user.save(update_fields=["is_active"])
+        if principal.role != session.role or not principal.is_active:
+            principal.role = session.role
+            principal.is_active = True
+            principal.save(update_fields=["role", "is_active", "updated_at"])
+
+    if binding is None:
+        if session.role != "owner":
+            raise ProvisioningError("community_not_provisioned")
+        workspace = Workspace.objects.create(
+            name="A2D2",
+            slug=f"a2d2-{str(session.community_id)}",
+            owner=user,
+        )
+        binding = A2D2ManagedWorkspace.objects.create(
+            community_id=session.community_id,
+            workspace=workspace,
+        )
+        # Managed mode has no separate Plane admin signup.  The verified relay
+        # owner is the bootstrap authority, so make the singleton instance
+        # ready in the same transaction as its first managed workspace.
+        Instance.objects.filter(is_setup_done=False).update(
+            is_setup_done=True,
+            instance_name="A2D2",
+        )
+    else:
+        workspace = binding.workspace
+
+    # A relay owner demotion is authoritative immediately.  Until the newly
+    # authoritative owner has signed in and claimed the provider workspace,
+    # fail closed instead of leaving the demoted principal able to exercise
+    # Plane's separate Workspace.owner shortcut with a lower member role.
+    if session.role != "owner" and workspace.owner_id == user.id:
+        raise ProvisioningError("owner_transfer_required")
+
+    if session.role == "owner" and workspace.owner_id != user.id:
+        WorkspaceMember.objects.filter(workspace=workspace, member=workspace.owner).update(role=15)
+        if binding.project_id is not None:
+            ProjectMember.objects.filter(project_id=binding.project_id, member=workspace.owner).update(role=15)
+        workspace.owner = user
+        workspace.save(update_fields=["owner", "updated_at"])
+
+    WorkspaceMember.objects.update_or_create(
+        workspace=workspace,
+        member=user,
+        defaults={"role": _workspace_role(session.role), "is_active": True},
+    )
+    _ensure_project_membership(binding, user, session.role)
+    ensure_managed_profile(user, workspace)
+    return ManagedIdentity(user=user, workspace=workspace, principal=principal)
+
+
+@transaction.atomic
+def deactivate(principal: A2D2ManagedPrincipal) -> None:
+    principal = A2D2ManagedPrincipal.objects.select_for_update().get(pk=principal.pk)
+    principal.is_active = False
+    principal.save(update_fields=["is_active", "updated_at"])
+    binding = A2D2ManagedWorkspace.objects.filter(community_id=principal.community_id).first()
+    if binding is not None:
+        WorkspaceMember.objects.filter(workspace=binding.workspace, member=principal.user).update(is_active=False)
+        if binding.project_id is not None:
+            ProjectMember.objects.filter(project_id=binding.project_id, member=principal.user).update(is_active=False)
diff --git a/apps/api/plane/a2d2/resolver.py b/apps/api/plane/a2d2/resolver.py
new file mode 100644
index 0000000000..2976ec1b7d
--- /dev/null
+++ b/apps/api/plane/a2d2/resolver.py
@@ -0,0 +1,250 @@
+import re
+from dataclasses import dataclass
+from uuid import UUID
+
+from django.db import transaction
+
+from plane.db.models import (
+    A2D2ManagedPrincipal,
+    A2D2ManagedWorkspace,
+    ProjectMember,
+    WorkspaceMember,
+)
+from plane.db.models.project import ROLE
+
+from .principals import (
+    ManagedPrincipalAuthority,
+    ProvisioningError,
+    _workspace_role,
+    expected_principal_key,
+    provision,
+)
+
+
+PUBKEY_RE = re.compile(r"[0-9a-f]{64}")
+MAX_RESOLVE_PUBKEYS = 100
+
+
+class PrincipalResolutionError(Exception):
+    pass
+
+
+class PrincipalAuthorizationError(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class PrincipalResolution:
+    principals: tuple[tuple[str, UUID], ...]
+    missing: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class PrincipalEnsure:
+    pubkey: str
+    principal_key: str
+    role: str
+
+
+def _parse_scope(data, *, member_key: str):
+    if not isinstance(data, dict) or set(data) != {
+        "community_id",
+        "workspace_slug",
+        "project_id",
+        member_key,
+    }:
+        raise ValueError("invalid_request")
+    workspace_slug = data["workspace_slug"]
+    if not isinstance(workspace_slug, str) or re.fullmatch(r"[A-Za-z0-9_-]{1,48}", workspace_slug) is None:
+        raise ValueError("invalid_request")
+    try:
+        community_id = UUID(str(data["community_id"]))
+        project_id = UUID(str(data["project_id"]))
+    except (TypeError, ValueError):
+        raise ValueError("invalid_request") from None
+    return community_id, workspace_slug, project_id, data[member_key]
+
+
+def parse_resolve_request(data) -> tuple[UUID, str, UUID, tuple[str, ...]]:
+    community_id, workspace_slug, project_id, pubkeys = _parse_scope(data, member_key="pubkeys")
+    if (
+        not isinstance(pubkeys, list)
+        or not 1 <= len(pubkeys) <= MAX_RESOLVE_PUBKEYS
+        or any(not isinstance(pubkey, str) or PUBKEY_RE.fullmatch(pubkey) is None for pubkey in pubkeys)
+        or len(set(pubkeys)) != len(pubkeys)
+    ):
+        raise ValueError("invalid_request")
+    return community_id, workspace_slug, project_id, tuple(pubkeys)
+
+
+def parse_ensure_request(
+    data,
+) -> tuple[UUID, str, UUID, tuple[PrincipalEnsure, ...]]:
+    community_id, workspace_slug, project_id, principals = _parse_scope(data, member_key="principals")
+    if not isinstance(principals, list) or not 1 <= len(principals) <= MAX_RESOLVE_PUBKEYS:
+        raise ValueError("invalid_request")
+    parsed: list[PrincipalEnsure] = []
+    for principal in principals:
+        if (
+            not isinstance(principal, dict)
+            or set(principal) != {"pubkey", "principal_key", "role"}
+            or not isinstance(principal["pubkey"], str)
+            or PUBKEY_RE.fullmatch(principal["pubkey"]) is None
+            or not isinstance(principal["principal_key"], str)
+            or PUBKEY_RE.fullmatch(principal["principal_key"]) is None
+            or principal["role"] not in {"owner", "admin", "member"}
+        ):
+            raise ValueError("invalid_request")
+        parsed.append(
+            PrincipalEnsure(
+                pubkey=principal["pubkey"],
+                principal_key=principal["principal_key"],
+                role=principal["role"],
+            )
+        )
+    if len({principal.pubkey for principal in parsed}) != len(parsed):
+        raise ValueError("invalid_request")
+    return community_id, workspace_slug, project_id, tuple(parsed)
+
+
+def _bound_scope(
+    *,
+    community_id: UUID,
+    workspace_slug: str,
+    project_id: UUID,
+    lock: bool = False,
+) -> A2D2ManagedWorkspace:
+    query = A2D2ManagedWorkspace.objects.select_related("workspace", "project")
+    if lock:
+        query = query.select_for_update(of=("self",))
+    binding = query.filter(community_id=community_id).first()
+    if (
+        binding is None
+        or binding.workspace.slug != workspace_slug
+        or binding.project_id != project_id
+        or binding.project is None
+        or binding.project.workspace_id != binding.workspace_id
+        or binding.project.network != 0
+        or binding.project.archived_at is not None
+    ):
+        raise PrincipalResolutionError("principal_binding_conflict")
+    return binding
+
+
+def _assert_service_scope(binding: A2D2ManagedWorkspace, service_user_id: UUID) -> None:
+    workspace_member = WorkspaceMember.objects.filter(
+        workspace=binding.workspace,
+        member_id=service_user_id,
+        is_active=True,
+        role=ROLE.ADMIN.value,
+    ).exists()
+    project_member = ProjectMember.objects.filter(
+        workspace=binding.workspace,
+        project=binding.project,
+        member_id=service_user_id,
+        is_active=True,
+        role=ROLE.ADMIN.value,
+    ).exists()
+    if not workspace_member or not project_member:
+        raise PrincipalAuthorizationError("service_scope_denied")
+
+
+def resolve_principals(
+    *,
+    community_id: UUID,
+    workspace_slug: str,
+    project_id: UUID,
+    pubkeys: tuple[str, ...],
+    service_user_id: UUID,
+) -> PrincipalResolution:
+    binding = _bound_scope(
+        community_id=community_id,
+        workspace_slug=workspace_slug,
+        project_id=project_id,
+    )
+    _assert_service_scope(binding, service_user_id)
+    principal_by_pubkey = {
+        principal.nostr_pubkey: principal
+        for principal in A2D2ManagedPrincipal.objects.select_related("user").filter(
+            community_id=community_id,
+            nostr_pubkey__in=pubkeys,
+        )
+    }
+    user_ids = [principal.user_id for principal in principal_by_pubkey.values()]
+    workspace_members = dict(
+        WorkspaceMember.objects.filter(
+            workspace=binding.workspace,
+            member_id__in=user_ids,
+            is_active=True,
+        ).values_list("member_id", "role")
+    )
+    project_members = dict(
+        ProjectMember.objects.filter(
+            workspace=binding.workspace,
+            project=binding.project,
+            member_id__in=user_ids,
+            is_active=True,
+        ).values_list("member_id", "role")
+    )
+
+    resolved: list[tuple[str, UUID]] = []
+    missing: list[str] = []
+    for pubkey in pubkeys:
+        principal = principal_by_pubkey.get(pubkey)
+        if principal is None:
+            missing.append(pubkey)
+            continue
+        if (
+            not principal.is_active
+            or not principal.user.is_active
+            or not principal.user.is_managed
+            or principal.principal_key != expected_principal_key(community_id, pubkey)
+            or workspace_members.get(principal.user_id) != _workspace_role(principal.role)
+            or project_members.get(principal.user_id) != _workspace_role(principal.role)
+            or (principal.role == "owner") != (binding.workspace.owner_id == principal.user_id)
+        ):
+            raise PrincipalResolutionError("principal_mapping_conflict")
+        resolved.append((pubkey, principal.user_id))
+    return PrincipalResolution(tuple(resolved), tuple(missing))
+
+
+@transaction.atomic
+def ensure_principals(
+    *,
+    community_id: UUID,
+    workspace_slug: str,
+    project_id: UUID,
+    principals: tuple[PrincipalEnsure, ...],
+    service_user_id: UUID,
+) -> PrincipalResolution:
+    binding = _bound_scope(
+        community_id=community_id,
+        workspace_slug=workspace_slug,
+        project_id=project_id,
+        lock=True,
+    )
+    _assert_service_scope(binding, service_user_id)
+    for principal in principals:
+        if principal.principal_key != expected_principal_key(community_id, principal.pubkey):
+            raise PrincipalResolutionError("principal_mapping_conflict")
+        try:
+            provision(
+                ManagedPrincipalAuthority(
+                    community_id=community_id,
+                    pubkey=principal.pubkey,
+                    role=principal.role,
+                    principal_key=principal.principal_key,
+                )
+            )
+        except ProvisioningError as error:
+            raise PrincipalResolutionError(str(error)) from error
+    resolution = resolve_principals(
+        community_id=community_id,
+        workspace_slug=workspace_slug,
+        project_id=project_id,
+        pubkeys=tuple(principal.pubkey for principal in principals),
+        service_user_id=service_user_id,
+    )
+    if resolution.missing:
+        raise PrincipalResolutionError("principal_mapping_conflict")
+    return resolution
