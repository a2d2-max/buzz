@@ -0,0 +1,37 @@
+#!/usr/bin/env python3
+"""Read-only origin smoke check. Exit 2 means instance setup remains incomplete.
+Does not establish authentication, persistence, uploads, or native WebView acceptance.
+"""
+import json
+import sys
+import urllib.request
+import urllib.parse
+
+if len(sys.argv) != 2:
+    raise SystemExit("Usage: python3 verify-origin.py https://plane.example.com")
+origin = sys.argv[1].rstrip("/")
+url = urllib.parse.urlsplit(origin)
+if url.scheme not in ("http", "https") or not url.netloc or url.path or url.query or url.fragment or url.username:
+    raise SystemExit("Expected an HTTP(S) origin without path, credentials, query, or fragment")
+for path in ("/", "/god-mode/", "/spaces/", "/auth/get-csrf-token/", "/api/instances/"):
+    request = urllib.request.Request(origin + path, headers={"Accept": "application/json" if path.startswith(("/api/", "/auth/")) else "text/html"})
+    with urllib.request.urlopen(request, timeout=30) as response:
+        if urllib.parse.urlsplit(response.url).netloc != url.netloc:
+            raise SystemExit(f"Unexpected cross-origin redirect: {path}")
+        body = response.read()
+        mime = response.headers.get_content_type()
+        if response.status != 200:
+            raise SystemExit(f"Unexpected status: {path} {response.status}")
+    if path.startswith(("/api/", "/auth/")):
+        if mime != "application/json":
+            raise SystemExit(f"Expected JSON: {path}")
+        payload = json.loads(body)
+    elif mime != "text/html" or not body:
+        raise SystemExit(f"Expected nonempty HTML: {path}")
+    print(f"PASS {path}")
+    if path == "/api/instances/":
+        instance = payload.get("instance", payload)
+        if instance.get("is_setup_done") is not True:
+            print("SETUP REQUIRED: complete /god-mode/ then rerun")
+            raise SystemExit(2)
+print("Origin smoke passed; login/save/upload/restart/native checks still required.")
