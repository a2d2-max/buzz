diff --git a/apps/api/plane/a2d2/views.py b/apps/api/plane/a2d2/views.py
new file mode 100644
index 0000000000..e62f3e2caf
--- /dev/null
+++ b/apps/api/plane/a2d2/views.py
@@ -0,0 +1,124 @@
+import base64
+import hashlib
+import hmac
+import json
+import secrets
+import time
+from uuid import UUID
+
+from django.core import signing
+from django.http import JsonResponse
+from django.views.decorators.csrf import csrf_exempt
+from django.views.decorators.http import require_POST
+
+from plane.authentication.utils.login import user_login
+
+from .broker import BrokerClient, BrokerError
+from .config import load_config
+from .principals import ProvisioningError, provision
+
+
+STATE_COOKIE = "__Host-a2d2-plane-state"
+STATE_SALT = "plane.a2d2.callback-state.v1"
+STATE_TTL_SECONDS = 60
+MAX_EXCHANGE_BYTES = 4 * 1024
+
+
+def _error(code: str, status: int) -> JsonResponse:
+    return JsonResponse({"error": code}, status=status)
+
+
+def _same_origin(request, origin: str) -> bool:
+    return request.headers.get("Origin") == origin
+
+
+@csrf_exempt
+@require_POST
+def begin(request):
+    try:
+        config = load_config()
+    except ValueError:
+        return _error("a2d2_auth_unavailable", 503)
+    if not config.enabled or not _same_origin(request, config.origin):
+        return _error("a2d2_auth_unavailable", 403)
+    state = base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b"=").decode()
+    value = signing.dumps(
+        {"digest": hashlib.sha256(state.encode()).hexdigest()},
+        salt=STATE_SALT,
+    )
+    response = JsonResponse({"state": state})
+    response.set_cookie(
+        STATE_COOKIE,
+        value,
+        max_age=STATE_TTL_SECONDS,
+        path="/",
+        secure=True,
+        httponly=True,
+        samesite="Strict",
+    )
+    return response
+
+
+@csrf_exempt
+@require_POST
+def exchange(request):
+    try:
+        config = load_config()
+    except ValueError:
+        return _error("a2d2_auth_unavailable", 503)
+    if not config.enabled or not _same_origin(request, config.origin) or len(request.body) > MAX_EXCHANGE_BYTES:
+        return _error("a2d2_auth_unavailable", 403)
+    try:
+        body = json.loads(request.body)
+        if not isinstance(body, dict) or set(body) != {"code", "mount_session", "state"}:
+            raise ValueError
+        code = body["code"]
+        mount_session = str(UUID(body["mount_session"]))
+        state = body["state"]
+        if not isinstance(code, str) or not isinstance(state, str) or len(code) > 256 or len(state) > 128:
+            raise ValueError
+        cookie = signing.loads(
+            request.COOKIES.get(STATE_COOKIE, ""),
+            salt=STATE_SALT,
+            max_age=STATE_TTL_SECONDS,
+        )
+        expected = cookie.get("digest", "") if isinstance(cookie, dict) else ""
+        actual = hashlib.sha256(state.encode()).hexdigest()
+        if not hmac.compare_digest(expected, actual):
+            raise ValueError
+    except (ValueError, TypeError, signing.BadSignature, signing.SignatureExpired):
+        response = _error("callback_state_invalid", 403)
+        response.delete_cookie(STATE_COOKIE, path="/", samesite="Strict")
+        return response
+
+    try:
+        broker_session = BrokerClient(config).exchange(
+            code=code,
+            mount_session=mount_session,
+            callback_state=state,
+        )
+        identity = provision(broker_session)
+    except BrokerError as error:
+        response = _error(error.code, error.status_code if error.status_code in {403, 410, 503} else 502)
+        response.delete_cookie(STATE_COOKIE, path="/", samesite="Strict")
+        return response
+    except ProvisioningError as error:
+        response = _error(str(error), 409)
+        response.delete_cookie(STATE_COOKIE, path="/", samesite="Strict")
+        return response
+
+    user_login(request=request, user=identity.user, is_app=True)
+    request.session["a2d2_engine_session_token"] = broker_session.session_token
+    request.session["a2d2_engine_community_id"] = str(broker_session.community_id)
+    request.session["a2d2_engine_pubkey"] = broker_session.pubkey
+    request.session["a2d2_engine_principal_key"] = broker_session.principal_key
+    request.session.set_expiry(max(1, min(15 * 60, broker_session.expires_at - int(time.time()))))
+    response = JsonResponse(
+        {
+            "authenticated": True,
+            "workspace_slug": identity.workspace.slug,
+            "expires_at": broker_session.expires_at,
+        }
+    )
+    response.delete_cookie(STATE_COOKIE, path="/", samesite="Strict")
+    return response
diff --git a/apps/api/plane/db/management/commands/backfill_a2d2_managed_principals.py b/apps/api/plane/db/management/commands/backfill_a2d2_managed_principals.py
new file mode 100644
index 0000000000..6ff686eaa7
--- /dev/null
+++ b/apps/api/plane/db/management/commands/backfill_a2d2_managed_principals.py
@@ -0,0 +1,48 @@
+import json
+import os
+import stat
+
+from django.core.management.base import BaseCommand, CommandError
+
+from plane.a2d2.backfill import (
+    BackfillError,
+    backfill_existing_principals,
+    parse_backfill_manifest,
+)
+
+
+MAX_MANIFEST_BYTES = 256 * 1024
+
+
+def _read_manifest(path: str):
+    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
+    descriptor = os.open(path, flags)
+    try:
+        metadata = os.fstat(descriptor)
+        if not stat.S_ISREG(metadata.st_mode) or metadata.st_size > MAX_MANIFEST_BYTES:
+            raise CommandError("manifest must be a bounded regular file")
+        with os.fdopen(descriptor, "rb", closefd=False) as manifest_file:
+            payload = manifest_file.read(MAX_MANIFEST_BYTES + 1)
+        if len(payload) > MAX_MANIFEST_BYTES:
+            raise CommandError("manifest is too large")
+    finally:
+        os.close(descriptor)
+    try:
+        return json.loads(payload)
+    except (UnicodeDecodeError, json.JSONDecodeError) as error:
+        raise CommandError("manifest is not valid JSON") from error
+
+
+class Command(BaseCommand):
+    help = "Bind verified existing Plane users to A2D2 principals without email matching."
+
+    def add_arguments(self, parser):
+        parser.add_argument("--manifest", required=True)
+
+    def handle(self, *args, **options):
+        try:
+            manifest = parse_backfill_manifest(_read_manifest(options["manifest"]))
+            count = backfill_existing_principals(manifest)
+        except (BackfillError, OSError) as error:
+            raise CommandError(str(error)) from error
+        self.stdout.write(self.style.SUCCESS(f"Reconciled {count} A2D2 Plane principal(s)."))
