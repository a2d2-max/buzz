+  if (inFlightSessionChecks.size >= MAX_CONCURRENT_SESSION_CHECKS) {
+    throw new AppError("Authentication capacity exhausted", { code: "AUTH_CHECK_CAPACITY" });
+  }
+
+  const pending = handleAuthentication({ cookie: managed.cookie, userId: managed.userId });
+  inFlightSessionChecks.set(key, pending);
