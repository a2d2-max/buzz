+from rest_framework import status
+from rest_framework.exceptions import PermissionDenied
+from rest_framework.response import Response
+
+from plane.api.middleware.api_authentication import APIKeyAuthentication
+from plane.api.views.base import BaseAPIView
+
+from .config import load_config
+from .resolver import (
+    PrincipalAuthorizationError,
+    PrincipalResolutionError,
+    ensure_principals,
+    parse_ensure_request,
+    parse_resolve_request,
+    resolve_principals,
+)
+
+
+class A2D2ServiceAPIKeyAuthentication(APIKeyAuthentication):
+    """Require the configured service credential on provider-only routes."""
+
+    def authenticate(self, request):
+        if not self.get_api_token(request):
+            raise PermissionDenied("A2D2 service credential required")
+        return super().authenticate(request)
+
+
+class PrincipalResolveView(BaseAPIView):
+    authentication_classes = [A2D2ServiceAPIKeyAuthentication]
+
+    def post(self, request):
+        try:
+            config = load_config()
+        except ValueError:
+            return Response(
+                {"error": "a2d2_auth_unavailable"},
+                status=status.HTTP_503_SERVICE_UNAVAILABLE,
+            )
+        if not config.enabled:
+            return Response(
+                {"error": "a2d2_managed_auth_required"},
+                status=status.HTTP_403_FORBIDDEN,
+            )
+        try:
+            community_id, workspace_slug, project_id, pubkeys = parse_resolve_request(request.data)
+            resolution = resolve_principals(
+                community_id=community_id,
+                workspace_slug=workspace_slug,
+                project_id=project_id,
+                pubkeys=pubkeys,
+                service_user_id=request.user.id,
+            )
+        except ValueError:
+            return Response({"error": "invalid_request"}, status=status.HTTP_400_BAD_REQUEST)
+        except PrincipalAuthorizationError as error:
+            return Response({"error": str(error)}, status=status.HTTP_403_FORBIDDEN)
+        except PrincipalResolutionError as error:
+            return Response({"error": str(error)}, status=status.HTTP_409_CONFLICT)
+        return Response(
+            {
+                "principals": [
+                    {"pubkey": pubkey, "user_id": str(user_id)} for pubkey, user_id in resolution.principals
+                ],
+                "missing": list(resolution.missing),
+            }
+        )
+
+
+class PrincipalEnsureView(BaseAPIView):
+    authentication_classes = [A2D2ServiceAPIKeyAuthentication]
+
+    def post(self, request):
+        try:
+            config = load_config()
+        except ValueError:
+            return Response(
+                {"error": "a2d2_auth_unavailable"},
+                status=status.HTTP_503_SERVICE_UNAVAILABLE,
+            )
+        if not config.enabled:
+            return Response(
+                {"error": "a2d2_managed_auth_required"},
+                status=status.HTTP_403_FORBIDDEN,
+            )
+        try:
+            community_id, workspace_slug, project_id, principals = parse_ensure_request(request.data)
+            resolution = ensure_principals(
+                community_id=community_id,
+                workspace_slug=workspace_slug,
+                project_id=project_id,
+                principals=principals,
+                service_user_id=request.user.id,
+            )
+        except ValueError:
+            return Response({"error": "invalid_request"}, status=status.HTTP_400_BAD_REQUEST)
+        except PrincipalAuthorizationError as error:
+            return Response({"error": str(error)}, status=status.HTTP_403_FORBIDDEN)
+        except PrincipalResolutionError as error:
+            return Response({"error": str(error)}, status=status.HTTP_409_CONFLICT)
+        return Response(
+            {"principals": [{"pubkey": pubkey, "user_id": str(user_id)} for pubkey, user_id in resolution.principals]}
+        )
