+# Copyright (c) 2023-present Plane Software, Inc. and contributors
+# SPDX-License-Identifier: AGPL-3.0-only
+
+from django.db import models
+
+from .base import BaseModel
+
+
+class A2D2ManagedWorkspace(BaseModel):
+    """One Plane workspace durably bound to one A2D2 community."""
+
+    community_id = models.UUIDField(unique=True, db_index=True)
+    workspace = models.OneToOneField(
+        "db.Workspace",
+        on_delete=models.PROTECT,
+        related_name="a2d2_managed_workspace",
+    )
+    project = models.OneToOneField(
+        "db.Project",
+        null=True,
+        blank=True,
+        on_delete=models.PROTECT,
+        related_name="a2d2_managed_workspace",
+    )
+
+    class Meta:
+        db_table = "a2d2_managed_workspaces"
+
+
+class A2D2ManagedPrincipal(BaseModel):
+    """One internal Plane user bound to one A2D2 community member."""
+
+    community_id = models.UUIDField(db_index=True)
+    nostr_pubkey = models.CharField(max_length=64)
+    principal_key = models.CharField(max_length=64, unique=True)
+    user = models.OneToOneField(
+        "db.User",
+        on_delete=models.PROTECT,
+        related_name="a2d2_managed_principal",
+    )
+    role = models.CharField(max_length=16)
+    is_active = models.BooleanField(default=True)
+
+    class Meta:
+        db_table = "a2d2_managed_principals"
+        constraints = [
+            models.UniqueConstraint(
+                fields=["community_id", "nostr_pubkey"],
+                name="a2d2_principal_unique_community_pubkey",
+            )
+        ]
