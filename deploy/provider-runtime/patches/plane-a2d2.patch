+const MAX_CONCURRENT_SESSION_CHECKS = 128;
+const inFlightSessionChecks = new Map<string, ReturnType<typeof handleAuthentication>>();
+
+/** Revalidate the managed A2D2 session before every live protocol message. */
+export const beforeHandleMessage = async ({ context }: beforeHandleMessagePayload) => {
+  const managed = context as HocusPocusServerContext;
+  const key = createHash("sha256").update(managed.userId).update("\0").update(managed.cookie).digest("hex");
+  const current = inFlightSessionChecks.get(key);
