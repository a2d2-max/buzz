+        self.assertEqual(check.call_count, len(paths))
+        self.assertEqual(ProjectMemberInvite.objects.count(), 0)
+        self.assertEqual(WorkspaceMemberInvite.objects.count(), 0)
+        self.assertEqual(User.objects.count(), before_users)
+
+    def test_managed_mode_rejects_personal_api_tokens_even_when_hash_matches(self):
