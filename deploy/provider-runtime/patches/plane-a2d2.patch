+    @staticmethod
+    def write_manifest(manifest: dict) -> str:
+        descriptor, path = tempfile.mkstemp(suffix=".json")
+        with os.fdopen(descriptor, "w") as manifest_file:
+            json.dump(manifest, manifest_file)
+        return path
+
+    @staticmethod
+    def manifest(community_id, workspace, project, principals):
+        return {
+            "community_id": str(community_id),
+            "workspace_id": str(workspace.id),
+            "workspace_slug": workspace.slug,
+            "project_id": str(project.id),
+            "principals": principals,
+        }
+
+    def run_backfill(self, manifest):
+        path = self.write_manifest(manifest)
+        self.addCleanup(lambda: os.path.exists(path) and os.unlink(path))
+        call_command("backfill_a2d2_managed_principals", manifest=path)
+
+    def resolve(self, *, community_id, workspace, project, pubkeys, token=SERVICE_TOKEN):
+        return Client().post(
+            "/api/a2d2/principals/resolve",
+            data=json.dumps(
+                {
+                    "community_id": str(community_id),
+                    "workspace_slug": workspace.slug,
