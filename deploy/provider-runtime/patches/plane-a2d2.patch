+from unittest.mock import patch
+
+import requests
+from django.test import SimpleTestCase
+
+from plane.a2d2.broker import BrokerClient, BrokerError
+from plane.a2d2.config import A2D2EngineConfig
+
+
+class BrokerClientTest(SimpleTestCase):
+    def test_timeout_becomes_transient_unavailable_without_exposing_request_data(self):
+        client = BrokerClient(
+            A2D2EngineConfig(
+                enabled=True,
+                broker_url="https://relay.example.test",
+                origin="https://plane.example.test",
+                secret=b"s" * 32,
+            )
+        )
+        with patch("plane.a2d2.broker.requests.post", side_effect=requests.Timeout):
+            with self.assertRaises(BrokerError) as raised:
+                client.check("opaque-session-token-with-enough-bytes")
+        self.assertEqual(raised.exception.status_code, 503)
+        self.assertEqual(raised.exception.code, "broker_unavailable")
