+import hashlib
+import json
+import os
+import time
+from unittest.mock import patch
+from uuid import UUID, uuid4
+
+from django.test import Client, TestCase
+from django.utils import timezone
+
+from plane.a2d2.broker import BrokerError, BrokerSession
+from plane.a2d2.principals import expected_principal_key
+from plane.a2d2.views import STATE_COOKIE
+from plane.db.models import (
+    A2D2ManagedPrincipal,
+    A2D2ManagedWorkspace,
+    APIToken,
+    ProjectMemberInvite,
+    User,
+    WorkspaceMember,
+    WorkspaceMemberInvite,
+)
+from plane.license.models import Instance
+
+
+ORIGIN = "https://plane.example.test"
+AUTH_ENV = {
+    "PLANE_A2D2_AUTH_ENABLED": "true",
+    "PLANE_A2D2_BROKER_URL": "https://relay.example.test",
+    "PLANE_A2D2_ORIGIN": ORIGIN,
+    "PLANE_A2D2_ENGINE_SECRET": "s" * 32,
+    "PLANE_A2D2_SERVICE_API_TOKEN_SHA256": "0" * 64,
+}
+
+
+def broker_session(
+    *,
+    community_id: UUID,
+    pubkey: str,
+    principal_key: str,
+    role: str,
+) -> BrokerSession:
+    return BrokerSession(
+        session_token=f"session-{principal_key}",
+        community_id=community_id,
+        pubkey=pubkey,
+        role=role,
+        principal_key=expected_principal_key(community_id, pubkey),
+        expires_at=int(time.time()) + 600,
+    )
+
+
+class ManagedSessionTest(TestCase):
+    def setUp(self):
+        self.env = patch.dict(os.environ, AUTH_ENV, clear=False)
+        self.env.start()
+        self.addCleanup(self.env.stop)
+
+    def exchange(self, client: Client, session: BrokerSession):
+        begin = client.post(
+            "/api/a2d2/session/begin",
+            data="{}",
+            content_type="application/json",
+            HTTP_ORIGIN=ORIGIN,
+        )
+        self.assertEqual(begin.status_code, 200)
+        self.assertIn(STATE_COOKIE, begin.cookies)
+        state = begin.json()["state"]
+        with patch("plane.a2d2.views.BrokerClient.exchange", return_value=session) as exchange:
+            response = client.post(
+                "/api/a2d2/session/exchange",
+                data=json.dumps(
+                    {
+                        "code": "c" * 43,
+                        "mount_session": str(uuid4()),
+                        "state": state,
+                    }
+                ),
+                content_type="application/json",
+                HTTP_ORIGIN=ORIGIN,
+            )
+        self.assertEqual(response.status_code, 200)
+        exchange.assert_called_once()
+        return response
+
+    def test_two_members_get_distinct_users_in_one_managed_workspace(self):
+        instance = Instance.objects.first()
+        if instance is None:
+            instance = Instance.objects.create(
+                instance_name="Plane Community Edition",
+                instance_id=uuid4().hex,
+                current_version="test",
+                last_checked_at=timezone.now(),
+            )
+        instance.is_setup_done = False
+        instance.save(update_fields=["is_setup_done", "updated_at"])
+        community_id = uuid4()
+        owner = broker_session(
+            community_id=community_id,
+            pubkey="11" * 32,
+            principal_key="aa" * 32,
+            role="owner",
+        )
+        member = broker_session(
+            community_id=community_id,
+            pubkey="22" * 32,
+            principal_key="bb" * 32,
+            role="member",
+        )
+
+        owner_response = self.exchange(Client(), owner)
+        instance.refresh_from_db()
+        self.assertTrue(instance.is_setup_done)
+        self.assertEqual(instance.instance_name, "A2D2")
+        member_response = self.exchange(Client(), member)
+
+        self.assertNotIn("session_token", owner_response.json())
+        self.assertEqual(owner_response.json()["workspace_slug"], member_response.json()["workspace_slug"])
+        self.assertEqual(A2D2ManagedWorkspace.objects.count(), 1)
+        self.assertEqual(A2D2ManagedPrincipal.objects.count(), 2)
+        self.assertEqual(User.objects.filter(is_managed=True).count(), 2)
+        roles = sorted(WorkspaceMember.objects.values_list("role", flat=True))
+        self.assertEqual(roles, [15, 20])
+
+    def test_original_sign_out_revokes_managed_broker_session_before_logout(self):
+        community_id = uuid4()
+        session = broker_session(
+            community_id=community_id,
+            pubkey="91" * 32,
+            principal_key="a1" * 32,
+            role="owner",
+        )
+        client = Client()
+        self.exchange(client, session)
+
+        with (
+            patch("plane.a2d2.middleware.BrokerClient.check", return_value=session),
+            patch("plane.a2d2.middleware.BrokerClient.revoke") as revoke,
+        ):
+            response = client.post("/auth/sign-out/")
+
+        self.assertEqual(response.status_code, 302)
+        revoke.assert_called_once_with(session.session_token)
+        self.assertNotIn("a2d2_engine_session_token", client.session)
+
+    def test_original_sign_out_does_not_report_success_when_broker_revoke_fails(self):
+        community_id = uuid4()
+        session = broker_session(
+            community_id=community_id,
+            pubkey="92" * 32,
+            principal_key="a2" * 32,
+            role="owner",
+        )
+        client = Client()
+        self.exchange(client, session)
+
+        with (
+            patch("plane.a2d2.middleware.BrokerClient.check", return_value=session),
+            patch(
+                "plane.a2d2.middleware.BrokerClient.revoke",
+                side_effect=BrokerError(503, "broker_unavailable"),
+            ),
+        ):
+            response = client.post("/auth/sign-out/")
+
+        self.assertEqual(response.status_code, 503)
+        self.assertIn("a2d2_engine_session_token", client.session)
+
+    def test_managed_mode_blocks_vendor_password_auth_without_creating_users(self):
+        before = User.objects.count()
+        response = Client().post(
+            "/auth/sign-up/",
+            data={
+                "email": "vendor-signup@example.invalid",
+                "password": "not-a-real-password",
+            },
+            HTTP_ORIGIN=ORIGIN,
+        )
+
+        self.assertEqual(response.status_code, 403)
+        self.assertEqual(response.json(), {"error": "a2d2_managed_auth_required"})
+        self.assertEqual(User.objects.count(), before)
+        self.assertEqual(A2D2ManagedPrincipal.objects.count(), 0)
+
+    def test_managed_mode_rejects_a_preexisting_legacy_user_session(self):
+        user = User.objects.create_user(
+            email="legacy-user@example.invalid",
+            username="legacy-user",
+            password="not-a-real-password",
+        )
+        client = Client()
+        client.force_login(user)
+
+        response = client.get("/api/users/me/")
+
+        self.assertEqual(response.status_code, 401)
+        self.assertEqual(response.json(), {"error": "a2d2_managed_auth_required"})
+        self.assertNotIn("_auth_user_id", client.session)
+        self.assertEqual(A2D2ManagedPrincipal.objects.count(), 0)
+
+    def test_managed_mode_blocks_personal_api_token_creation(self):
+        session = broker_session(
+            community_id=uuid4(),
+            pubkey="aa" * 32,
+            principal_key="44" * 32,
+            role="owner",
+        )
+        client = Client()
+        self.exchange(client, session)
+
+        response = client.post(
+            "/api/users/api-tokens/",
+            data=json.dumps({"label": "personal-bypass"}),
+            content_type="application/json",
+        )
+
+        self.assertEqual(response.status_code, 403)
+        self.assertEqual(response.json(), {"error": "a2d2_managed_auth_required"})
+        self.assertEqual(APIToken.objects.count(), 0)
+
+    def test_managed_mode_blocks_vendor_workspace_and_membership_mutations(self):
+        session = broker_session(
+            community_id=uuid4(),
+            pubkey="ab" * 32,
+            principal_key="45" * 32,
+            role="owner",
+        )
+        client = Client()
+        exchange = self.exchange(client, session)
+        workspace_slug = exchange.json()["workspace_slug"]
