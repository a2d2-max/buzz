+++ b/deployments/a2d2/lock-images.py
@@ -0,0 +1,23 @@
+#!/usr/bin/env python3
+"""Remote host only: read compose JSON on stdin; emit immutable local image IDs.
+Does not pull, build, or start containers. Do not save the input (contains secrets).
+"""
+import json
+import re
+import subprocess
+import sys
+
+config = json.load(sys.stdin)
+lines = ["# Host-local image lock; transfer images with docker save/load if moving hosts.", "services:"]
+for name, service in config["services"].items():
+    image = json.loads(subprocess.check_output(
+        ["docker", "image", "inspect", service["image"]], text=True
+    ))[0]
+    if image.get("Architecture") != "amd64" or image.get("Os") != "linux":
+        raise SystemExit(f"Wrong platform: {name}")
+    ident = image["Id"]
+    if not re.fullmatch(r"sha256:[0-9a-f]{64}", ident):
+        raise SystemExit(f"Invalid image ID: {name}")
+    lines += [f"  {name}:", f'    image: "{ident}"',
+              "    pull_policy: never", "    build: !reset null"]
+print("\n".join(lines))
