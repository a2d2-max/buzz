+            project=project,
+            principals=[
+                {
+                    "pubkey": first_pubkey,
+                    "principal_key": expected_principal_key(community_id, first_pubkey),
+                    "role": "member",
+                }
+            ],
+            token="",
+        )
+        self.assertEqual(without_token.status_code, 403)
+
+        partial_conflict = self.ensure(
+            community_id=community_id,
+            workspace=workspace,
+            project=project,
+            principals=[
+                {
+                    "pubkey": first_pubkey,
+                    "principal_key": expected_principal_key(community_id, first_pubkey),
+                    "role": "member",
+                },
+                {
+                    "pubkey": second_pubkey,
+                    "principal_key": "ff" * 32,
+                    "role": "member",
