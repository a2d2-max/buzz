{
  "name": "buzz-tv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "browserslist": [
    "Chrome 68"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "check": "biome check . && pnpm typecheck && pnpm test && pnpm build && node scripts/check-chrome68.mjs",
    "format": "biome format --write .",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.mjs\"",
    "mock-relay": "node scripts/mock-relay.mjs",
    "verify:hosted": "node scripts/verify-hosted-chrome68.mjs"
  },
  "dependencies": {
    "@noriginmedia/norigin-spatial-navigation": "^3.3.0",
    "core-js": "^3.50.0",
    "nostr-tools": "^2.23.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.0",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "ws": "^8.18.0"
  }
}
